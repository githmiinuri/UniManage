<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniManage Student</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-width: 260px;
            --bg-light: #f8fafc;
            --accent-blue: #0b4f8a;
        }

        body {
            background-color: var(--bg-light);
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }

        /* The wrapper for the entire page */
        .student-shell {
            display: flex;
            min-height: 100vh;
        }

        /* Content area adjustments to clear the fixed sidebar */
        .student-content {
            flex: 1;
            margin-left: var(--sidebar-width);
            padding: 30px;
            transition: margin-left 0.3s ease;
        }

        /* Top Bar for Page Titles / Breadcrumbs */
        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title h2 {
            font-weight: 700;
            color: var(--accent-blue);
            margin: 0;
            font-size: 1.5rem;
        }

        /* Responsive adjustment for mobile */
        @@media (max-width: 992px) {
            .student-content {
                margin-left: 0;
                padding: 20px;
            }
        }
    </style>
</head>
<body>

    <div class="student-shell">
        @await Html.PartialAsync("_StudentSidebar")

        <main class="student-content">
            <header class="content-header">
                <div class="page-title">
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="header-tools">
                    <span class="text-muted small">@DateTime.Now.ToString("D")</span>
                </div>
            </header>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
