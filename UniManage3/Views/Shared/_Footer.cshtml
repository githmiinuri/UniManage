@* Shared footer partial: single thin bottom strip used across pages *@
<footer class="site-footer" role="contentinfo">
    <div class="site-footer-inner">
        &copy; 2026 - Unimanage - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>

<style>
    /* Thin fixed footer strip used as the default copyright bar for all pages */
    .site-footer{
        position:relative;
        width:100%;
        height:28px; /* thin strip */
        display:flex;
        align-items:center;
        justify-content:center;
        background: rgba(11,79,138,0.92);
        box-shadow: none;
        padding:0 12px;
        font-size:0.9rem;
        border-top: 1px solid rgba(255,255,255,0.06); /* subtle separator so footer is visible */
    }

    .site-footer-inner{color:rgba(255,255,255,0.95); text-align:center; width:100%; max-width:1200px}
    .site-footer a{color:rgba(255,255,255,0.9); text-decoration:underline}

    /* Footer is fixed; pages should layout content to avoid overlap. Avoid globally touching body padding here. */
    @@media (max-width:576px){
        .site-footer{height:36px; font-size:0.85rem}
    }
</style>
<script>
    // For pages that set Layout = null, ensure footer sits after content by adding a small spacer when needed
    (function(){
        try{
            var f = document.querySelector('.site-footer');
            if (!f) return;
            // If body is not using flex column, append a spacer div above footer so footer appears at page bottom
            var bodyStyle = window.getComputedStyle(document.body);
            if (bodyStyle.display !== 'flex' || bodyStyle.flexDirection !== 'column'){
                var spacer = document.createElement('div');
                spacer.style.height = '20px';
                spacer.style.width = '100%';
                document.body.insertBefore(spacer, f);
            }
        } catch(e){/* ignore */}
    })();
</script>
