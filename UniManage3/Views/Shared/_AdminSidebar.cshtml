@inject UniManage3.Data.ApplicationDbContext _db
@{
    var email = User?.Identity?.Name;
    var userObj = _db.Users.FirstOrDefault(u => u.Email == email);
    var fullName = userObj?.FullName ?? email ?? "Administrator";

    // Logic to determine active state
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = null)
    {
        if (action == null) return currentController == controller;
        return currentController == controller && currentAction == action;
    }
}

<style>
    :root {
        --gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);
        --sidebar-width: 260px;
        --sidebar-collapsed: 64px;
        --accent-blue: #0b4f8a;
        --light-blue: #9fc8ff;
        --muted: #6c757d;
        --card-shadow: 0 8px 20px rgba(12, 42, 80, 0.06);
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
    }

    .left-bar {
        width: var(--sidebar-width);
        background: var(--gradient);
        color: #eaf4ff;
        padding: 18px 12px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transition: width .25s ease-in-out;
        z-index: 1000;
    }

        .left-bar .logo-top {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
        }

    .logo-mark {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-name {
        font-weight: 700;
        color: #eafbff;
    }

    .logo-username {
        font-size: .9rem;
        color: rgba(255,255,255,0.9);
        margin-top: 12px;
    }

    .menu {
        margin-top: 20px;
    }

        .menu .section {
            margin-bottom: 12px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px;
            border-radius: 8px;
            color: rgba(255,255,255,0.92);
            text-decoration: none;
            margin-bottom: 6px;
            transition: all 0.2s;
        }

            .menu a .icon {
                width: 26px;
                height: 26px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px;
            }

            .menu a:hover {
                background: rgba(255,255,255,0.06);
                color: #eaf4ff;
            }

            /* The active state you requested */
            .menu a.active {
                background: rgba(255,255,255,0.12);
                box-shadow: var(--card-shadow);
                color: #fff;
                font-weight: 500;
            }

        .menu .small {
            font-size: .85rem;
            color: rgba(255,255,255,0.85);
        }

    /* Submenu styles */
    .has-submenu .submenu-toggle {
        background: transparent;
        border: none;
        padding: 8px 10px;
        cursor: pointer;
        color: inherit;
        font: inherit;
        text-align: left;
        width: 100%;
        display: flex;
        align-items: center;
        border-radius: 8px;
        gap: 12px;
    }

    .has-submenu .chev {
        margin-left: auto;
        transition: transform .18s ease;
    }

    .has-submenu .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .22s ease, opacity .18s ease;
        padding-left: 32px;
        opacity: 0;
    }

    .has-submenu.open .chev {
        transform: rotate(90deg);
    }

    .has-submenu.open .submenu {
        opacity: 1;
        max-height: 400px;
    }

    .submenu a.sub-action {
        padding: 6px 8px;
        font-size: 0.85rem;
        margin: 2px 0;
    }

    .menu-inner {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
        scrollbar-width: none;
    }

        .menu-inner::-webkit-scrollbar {
            display: none;
        }
</style>

<aside class="left-bar" id="leftBar">
    <div class="logo-top">
        <div class="logo-mark">
            <div style="width:56px;height:56px;border-radius:12px;background:white;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(11,79,138,0.12);">
                <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="64" height="64" rx="12" fill="white" />
                    <path d="M32 4 L12 14 L32 24 L52 14 L32 4 Z" fill="#0b4f8a" />
                    <path d="M20 30 C24 34, 28 36, 32 36 C36 36,40 34,44 30 V46 C44 50,40 54,32 54 C24 54,20 50,20 46 V30 Z" fill="#6ea8fe" opacity="0.95" />
                    <path d="M32 34 C28 34,24 32,20 28" stroke="#0b4f8a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
            </div>
            <div class="brand-name">UniManage</div>
        </div>
    </div>

    <div class="logo-username" style="display:flex;align-items:center;gap:8px;margin-top:12px;padding: 0 8px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" style="flex:0 0 32px;border-radius:50%;background:rgba(255,255,255,0.06);padding:4px">
            <path d="M12 12a4 4 0 100-8 4 4 0 000 8z" stroke="#eaf4ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M4 20v-1c0-2.2 3.6-4 8-4s8 1.8 8 4v1" stroke="#eaf4ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div style="color:rgba(255,255,255,0.95);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@fullName</div>
    </div>

    <nav class="menu">
        <div class="menu-inner" id="menuInner">
            <div class="section">
                @* Dashboard *@
                <a href="@Url.Action("Index", "Admin")" class="@(IsActive("Admin", "Index") ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 13h8V3H3v10zM13 21h8v-6h-8v6zM13 3v6h8V3h-8zM3 21h8v-8H3v8z" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                    <span class="small">Dashboard</span>
                </a>

                @* User Management Submenu *@
                <div class="has-submenu @(IsActive("Admin") && currentAction.Contains("Management") ? "open" : "")">
                    <button type="button" class="submenu-toggle" onclick="toggleSub(this)">
                        <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM8 11c1.657 0 3-1.343 3-3S9.657 5 8 5 5 6.343 5 8s1.343 3 3 3zM8 13c-2.667 0-8 1.333-8 4v2h16v-2c0-2.667-5.333-4-8-4z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                        <span class="small">User Management</span>
                        <span class="chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#eaf4ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                    </button>
                    <div class="submenu">
                        <a href="@Url.Action("StudentManagement", "Admin")" class="sub-action @(IsActive("Admin", "StudentManagement") ? "active" : "")">
                            <span class="small">Student Management</span>
                        </a>
                        <a href="@Url.Action("LecturerManagement", "Admin")" class="sub-action @(IsActive("Admin", "LecturerManagement") ? "active" : "")">
                            <span class="small">Lecturer Management</span>
                        </a>
                        <a href="@Url.Action("AdministratorManagement", "Admin")" class="sub-action @(IsActive("Admin", "AdministratorManagement") ? "active" : "")">
                            <span class="small">Admin Management</span>
                        </a>
                    </div>
                </div>

                @* Other Items *@
                <a href="/Admin/Departments" class="@(currentController == "Admin" && currentAction == "Departments" ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="1" stroke="#9fc8ff" stroke-width="1.2" fill="none" /><path d="M8 20v-8h8v8" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M10 8v2M14 8v2" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span>
                    <span class="small">Departments</span>
                </a>

                <a href="@Url.Action("Index", "Courses")" class="@(IsActive("Courses") ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 8h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span>
                    <span class="small">Courses</span>
                </a>

                <a href="@Url.Action("Index", "Curriculum")" class="@(IsActive("Curriculum") ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 8h10M7 12h10M7 16h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span>
                    <span class="small">Curriculum</span>
                </a>

                <a href="#" class=""><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 6v14M3 6h18" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" /></svg></span><span class="small">Classes</span></a>
                <a href="#" class=""><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 21h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span><span class="small">Events</span></a>
                <a href="#" class=""><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3h18v18H3z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Library</span></a>

                <a href="@Url.Action("Enrollments", "Enrollments")" class="@(IsActive("Enrollments") ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3v18h18" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                    <span class="small">Enrollments</span>
                </a>

                <a href="#" class=""><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 7h10v10H7z" stroke="#9fc8ff" stroke-width="1.0" /></svg></span><span class="small">Reports</span></a>
                <a href="#" class=""><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l9 21H3L12 2z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Performance</span></a>

                <a href="/Account/EditProfile" class="@(IsActive("Account", "EditProfile") ? "active" : "")">
                    <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /><path d="M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></span>
                    <span class="small">Edit Profile</span>
                </a>
            </div>
        </div>
    </nav>

    <div style="position:absolute;left:12px;right:12px;bottom:18px">
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn" style="width:100%;background:#ff4d4f;color:white;border-radius:8px;padding:8px;border:none;cursor:pointer;font-weight:600">Logout</button>
        </form>
    </div>
</aside>

<script>
    function toggleSub(btn) {
        const parent = btn.closest('.has-submenu');
        const isOpen = parent.classList.contains('open');

        // Close others if you want accordion behavior (optional)
        // document.querySelectorAll('.has-submenu').forEach(el => el.classList.remove('open'));

        if (isOpen) {
            parent.classList.remove('open');
        } else {
            parent.classList.add('open');
        }
    }
</script>
