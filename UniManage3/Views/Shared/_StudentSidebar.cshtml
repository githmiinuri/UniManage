@inject UniManage3.Data.ApplicationDbContext _db
@{
    var email = User?.Identity?.Name;
    var user = _db.Users.FirstOrDefault(u => u.Email == email);
    var fullName = user?.FullName ?? email ?? "Student";
}

<style>
    /* Inherited Brand Variables */
    :root {
        --student-gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);
        --sidebar-width: 260px;
        --accent-blue: #0b4f8a;
        --light-blue: #9fc8ff;
    }

    .student-sidebar {
        width: var(--sidebar-width);
        background: var(--student-gradient);
        color: #eaf4ff;
        padding: 18px 12px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        z-index: 1000;
    }

    /* Logo Section matching Login/Admin */
    .logo-section {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 6px 8px;
        margin-bottom: 20px;
    }

    .logo-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 18px rgba(11,79,138,0.12);
    }

    .brand-text {
        font-weight: 700;
        font-size: 1.2rem;
        color: #eafbff;
    }

    /* Profile Section */
    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 8px;
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        margin-bottom: 24px;
    }

    .profile-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(255,255,255,0.95);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Menu Styling */
    .menu-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow-y: auto;
        flex-grow: 1;
        scrollbar-width: none;
    }

        .menu-list::-webkit-scrollbar {
            display: none;
        }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        color: rgba(255,255,255,0.85);
        text-decoration: none;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

        .menu-item:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }

        .menu-item.active {
            background: rgba(255,255,255,0.15);
            color: #fff;
            font-weight: 500;
        }

    .menu-icon {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Logout Section */
    .sidebar-footer {
        padding-top: 15px;
        margin-top: auto;
    }

    .logout-btn {
        width: 100%;
        height: 42px;
        background: #ff4d4f;
        color: white;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .logout-btn:hover {
            opacity: 0.9;
        }
</style>

<aside class="student-sidebar">
    <div class="logo-section">
        <div class="logo-box">
            <svg width="40" height="40" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M32 4 L12 14 L32 24 L52 14 L32 4 Z" fill="#0b4f8a" />
                <path d="M20 30 C24 34, 28 36, 32 36 C36 36,40 34,44 30 V46 C44 50,40 54,32 54 C24 54,20 50,20 46 V30 Z" fill="#6ea8fe" opacity="0.95" />
                <path d="M32 34 C28 34,24 32,20 28" stroke="#0b4f8a" stroke-width="1.5" stroke-linecap="round" fill="none" />
            </svg>
        </div>
        <span class="brand-text">UniManage</span>
    </div>

    <div class="user-profile">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="background:rgba(255,255,255,0.1); border-radius:50%; padding:4px;">
            <path d="M12 12a4 4 0 100-8 4 4 0 000 8z" stroke="#eaf4ff" stroke-width="1.5" />
            <path d="M4 20v-1c0-2.2 3.6-4 8-4s8 1.8 8 4v1" stroke="#eaf4ff" stroke-width="1.5" />
        </svg>
        <span class="profile-name">@fullName</span>
    </div>

    <nav class="menu-list">
        <a href="/Student/Dashboard" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-th-large"></i></span>
            <span>Dashboard</span>
        </a>

        <a href="/Student/BrowseCourses" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "BrowseCourses" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-search"></i></span>
            <span>Browse Courses</span>
        </a>

        <a href="/Student/MyCourses" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MyCourses" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-book"></i></span>
            <span>My Enrolled Courses</span>
        </a>

        <a href="/Student/Assignments" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Assignments" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-file-upload"></i></span>
            <span>Assignments & Submissions</span>
        </a>

        <a href="/Student/Grades" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Grades" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-chart-line"></i></span>
            <span>Grades & Feedback</span>
        </a>

        <a href="/Student/Calendar" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Calendar" ? "active" : "")">
            <span class="menu-icon"><i class="fas fa-calendar-alt"></i></span>
            <span>Academic Calendar</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout-btn">
                Logout
            </button>
        </form>
    </div>
</aside>
