@model UniManage3.Models.ViewModels.LecturerReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="bg-light min-vh-100 py-4 py-lg-5">
    <div class="container">
        <header class="mb-4 pb-2">
            <h1 class="display-6 fw-bold text-dark mb-2">Academic Reports</h1>
            <p class="text-muted mb-0 fs-5">Class performance analytics for your teaching portfolio.</p>
        </header>

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-between gap-3 mb-3">
                    <div>
                        <h2 class="h5 fw-bold text-dark mb-1">Report filters</h2>
                        <p class="text-muted small mb-0">Choose a module and batch, then generate or print.</p>
                    </div>
                </div>
                <form method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-semibold text-dark" for="report-module">Select Module</label>
                            <select id="report-module" name="moduleId" asp-for="SelectedModuleId" asp-items="Model.Modules" class="form-select rounded-3 shadow-sm">
                                <option value="">-- Select Module --</option>
                            </select>
                        </div>
                        <div class="col-md-6 col-lg-4">
                            <label class="form-label fw-semibold text-dark" for="report-batch">Select Batch</label>
                            <select id="report-batch" name="batchId" asp-for="SelectedBatchId" asp-items="Model.Batches" class="form-select rounded-3 shadow-sm">
                                <option value="">-- Select Batch --</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6 col-lg-auto d-grid d-lg-inline-block">
                            <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm">Generate Report</button>
                        </div>
                        <div class="col-12 col-md-6 col-lg-auto ms-lg-auto text-end">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4 shadow-sm" onclick="window.print()">
                                <i class="bi bi-printer me-1" aria-hidden="true"></i> Print Report
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            <div class="col">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Total Submissions</div>
                        <div class="display-6 fw-bold text-primary">@Model.TotalSubmissions</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Class Average</div>
                        <div class="display-6 fw-bold text-primary">@(Model.ClassAverage > 0 ? Model.ClassAverage.ToString("0.##") : "N/A")</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Late Submissions</div>
                        <div class="display-6 fw-bold text-primary">@Model.LateSubmissions</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-white border-0 py-4 px-4 pb-0">
                <h2 class="h5 fw-bold text-dark mb-0">Detailed Student Performance</h2>
                <p class="text-muted small mt-2 mb-0">Submission status, marks, and grades for the current selection.</p>
            </div>
            <div class="card-body p-4 pt-3">
                <div class="table-responsive rounded-3">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead class="border-bottom">
                            <tr>
                                <th class="text-uppercase small text-muted fw-bold py-3">Student Name</th>
                                <th class="text-uppercase small text-muted fw-bold py-3">Assignment</th>
                                <th class="text-uppercase small text-muted fw-bold py-3">Status</th>
                                <th class="text-uppercase small text-muted fw-bold py-3">Marks</th>
                                <th class="text-uppercase small text-muted fw-bold py-3">Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Submissions == null || !Model.Submissions.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5 fst-italic">No records to display. Generate a report using the filters above.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var s in Model.Submissions)
                                {
                                    <tr>
                                        <td class="fw-medium text-dark">@(s.Student?.FullName ?? "Unknown")</td>
                                        <td>@(s.Assignment?.AssignmentName ?? "Unknown")</td>
                                        <td>
                                            @if (s.Status == UniManage3.Models.SubmissionStatus.OnTime)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 bg-success bg-opacity-10 text-success border border-success">On Time</span>
                                            }
                                            else if (s.Status == UniManage3.Models.SubmissionStatus.Late)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 bg-warning bg-opacity-10 text-warning border border-warning">Late</span>
                                            }
                                            else if (s.Status == UniManage3.Models.SubmissionStatus.Graded)
                                            {
                                                <span class="badge rounded-pill px-3 py-2 bg-primary bg-opacity-10 text-primary border border-primary">Graded</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-3 py-2 bg-secondary bg-opacity-10 text-secondary border border-secondary">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @if (s.Marks.HasValue)
                                            {
                                                @s.Marks.Value.ToString("0.##")
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Not Graded</span>
                                            }
                                        </td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(s.Grade))
                                            {
                                                <span class="text-muted fst-italic">-</span>
                                            }
                                            else
                                            {
                                                @s.Grade
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
