@model UniManage3.Models.ViewModels.LecturerReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-3 mb-4">
        <div class="card-body">
            <h4 class="card-title mb-3">Academic Performance Reports</h4>
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Module</label>
                    <select name="moduleId" asp-for="SelectedModuleId" asp-items="Model.Modules" class="form-select">
                        <option value="">-- Select Module --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Batch</label>
                    <select name="batchId" asp-for="SelectedBatchId" asp-items="Model.Batches" class="form-select">
                        <option value="">-- Select Batch --</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Generate Report</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="badge bg-primary rounded-3 p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-collection" viewBox="0 0 16 16">
                                <path d="M2.5 3a.5.5 0 0 0 0 1H13a.5.5 0 0 0 0-1H2.5z"/>
                                <path d="M2 6.5A1.5 1.5 0 0 1 3.5 5h9A1.5 1.5 0 0 1 14 6.5v6A1.5 1.5 0 0 1 12.5 14h-9A1.5 1.5 0 0 1 2 12.5v-6z"/>
                            </svg>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">Total Submissions</div>
                        <div class="h4 mb-0">@Model.TotalSubmissions</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="badge bg-success rounded-3 p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-speedometer2" viewBox="0 0 16 16">
                                <path d="M8 4a.5.5 0 0 1 .5.5v4.793l2.146 2.147a.5.5 0 0 1-.708.708L7.5 10.207V4.5A.5.5 0 0 1 8 4z"/>
                                <path d="M3.51 12.5a7 7 0 1 1 8.98 0l-.57.857A6 6 0 1 0 3.51 12.5l-.001-.001z"/>
                            </svg>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">Class Average</div>
                        <div class="h4 mb-0">@(Model.ClassAverage > 0 ? Model.ClassAverage.ToString("0.##") : "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm rounded-3 p-3 h-100">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="badge bg-warning text-dark rounded-3 p-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.706c.89 0 1.438-.99.982-1.767L8.982 1.566z"/>
                                <path d="M8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1-2.002 0 1 1 0 0 1 2.002 0z"/>
                            </svg>
                        </span>
                    </div>
                    <div>
                        <div class="text-muted small">Late Submissions</div>
                        <div class="h4 mb-0">@Model.LateSubmissions</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Submissions</h5>
                <div>
                    <button class="btn btn-outline-secondary" onclick="window.print()">
                        <i class="bi bi-printer"></i> Print Report
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Assignment</th>
                            <th>Status</th>
                            <th>Marks</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Submissions == null || !Model.Submissions.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted">No records to display. Generate a report using the filters above.</td></tr>
                        }
                        else
                        {
                            foreach (var s in Model.Submissions)
                            {
                                <tr>
                                    <td>@(s.Student?.FullName ?? "Unknown")</td>
                                    <td>@(s.Assignment?.AssignmentName ?? "Unknown")</td>
                                    <td>
                                        @if (s.Status == UniManage3.Models.SubmissionStatus.OnTime)
                                        {
                                            <span class="badge bg-success">On Time</span>
                                        }
                                        else if (s.Status == UniManage3.Models.SubmissionStatus.Late)
                                        {
                                            <span class="badge bg-danger">Late</span>
                                        }
                                        else if (s.Status == UniManage3.Models.SubmissionStatus.Graded)
                                        {
                                            <span class="badge bg-primary">Graded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pending</span>
                                        }
                                    </td>
                                    <td>@(s.Marks.HasValue ? s.Marks.Value.ToString("0.##") : "Not Graded")</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.Grade) ? "-" : s.Grade)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
