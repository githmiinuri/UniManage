@model UniManage3.Models.ViewModels.ChatIndexViewModel
@{
    ViewData["Title"] = "Student Chat";
}

<div class="container-fluid py-4" style="background:#f4f6f8;min-height:80vh;">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm rounded-3" style="height:80vh;">
                <div class="card-body d-flex flex-column p-2">
                    <div class="sticky-top bg-white py-2 mb-2" style="z-index:10;">
                        <div class="input-group">
                            <input id="searchBox" class="form-control" placeholder="Search student name or ID..." />
                            <select id="batchFilter" class="form-select" style="max-width:160px;">
                                <option value="">All Batches</option>
                                @foreach(var b in Model.Batches)
                                {
                                    <option value="@b.Id">@b.BatchName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div id="studentList" class="list-group list-group-flush overflow-auto mt-1" style="max-height:calc(80vh - 120px);">
                        @foreach(var s in Model.Students)
                        {
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center contact-card" data-student-id="@s.Id" data-student-name="@s.FullName">
                                <div class="flex-shrink-0 me-2">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px">@s.FullName.Substring(0,1)</div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <div><strong>@s.FullName</strong></div>
                                        <small class="text-muted">ID: @s.Id</small>
                                    </div>
                                    <div class="text-muted small">@s.NICNumber</div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm rounded-3 position-relative" style="height:80vh;">
                <div class="card-header bg-white d-flex align-items-center">
                    <div>
                        <h5 id="chatHeader" class="mb-0">Select a student to start messaging</h5>
                        <small id="chatSubHeader" class="text-muted">Lecturer Chat</small>
                    </div>
                </div>

                <div id="chatBody" class="card-body overflow-auto" style="max-height:calc(80vh - 170px);">
                    <div id="placeholder" class="text-center text-muted my-5">
                        <svg width="100" height="100" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="100" height="100" rx="12" fill="#fff"/><path d="M20 70c10-15 30-15 40 0" stroke="#ced4da" stroke-width="2" stroke-linecap="round"/></svg>
                        <div class="mt-3">Select a student to view conversation</div>
                    </div>

                    <div id="messages" style="display:none;"></div>
                </div>

                <div class="card-footer bg-white">
                    <form id="sendForm" class="d-flex" onsubmit="return false;">
                        <input type="hidden" id="currentStudentId" />
                        <select id="subjectCategory" class="form-select me-2" style="max-width:180px;">
                            <option value="0">General</option>
                            <option value="1">Assignment</option>
                            <option value="2">Grades</option>
                            <option value="3">Attendance</option>
                            <option value="99">Other</option>
                        </select>
                        <textarea id="messageText" class="form-control me-2" rows="2" placeholder="Type your message"></textarea>
                        <button id="sendBtn" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        (function(){
            function filterList(){
                var q = $('#searchBox').val().toLowerCase();
                var batch = $('#batchFilter').val();
                $('.contact-card').each(function(){
                    var name = $(this).data('student-name').toLowerCase();
                    var id = $(this).data('student-id').toString();
                    var keep = true;
                    if (q && !(name.indexOf(q) !== -1 || id.indexOf(q) !== -1)) keep = false;
                    if (batch) {
                        // Client doesn't have batch mapping per student in this simplified version — skip this filter if not present
                    }
                    $(this).toggle(keep);
                });
            }

            $('#searchBox').on('input', filterList);
            $('#batchFilter').on('change', filterList);

            $('.contact-card').on('click', function(e){
                e.preventDefault();
                $('.contact-card').removeClass('active');
                $(this).addClass('active');

                var studentId = $(this).data('student-id');
                var studentName = $(this).data('student-name');
                $('#currentStudentId').val(studentId);
                $('#chatHeader').text(studentName);
                $('#placeholder').hide();
                $('#messages').show().html('<div class="text-center text-muted">Loading...</div>');

                $.get('/Lecture/Chat/GetChatThread', { studentId: studentId }, function(data){
                    renderMessages(data);
                });
            });

            function renderMessages(messages){
                var container = $('#messages');
                container.empty();
                if (!messages || messages.length === 0){
                    container.append('<div class="text-muted">No messages yet. Use the box below to send the first reply.</div>');
                    scrollToBottom();
                    return;
                }

                messages.forEach(function(m){
                    // Student message
                    if (m.Message){
                        var studentBubble = $('<div class="mb-3 d-flex">')
                            .append('<div class="bg-white rounded-3 shadow-sm p-3 me-auto" style="max-width:70%">' + $('<div>').text(m.Message).html() + '<div class="text-muted small mt-2">' + m.SentAt + '</div></div>');
                        container.append(studentBubble);
                    }

                    // Lecturer reply
                    if (m.Reply){
                        var lectBubble = $('<div class="mb-3 d-flex">')
                            .append('<div class="bg-primary text-white rounded-3 shadow-sm p-3 ms-auto" style="max-width:70%">' + $('<div>').text(m.Reply).html() + '<div class="text-light small mt-2">' + (m.RepliedAt||'') + '</div></div>');
                        container.append(lectBubble);
                    }
                });

                scrollToBottom();
            }

            function scrollToBottom(){
                var el = $('#messages');
                el.scrollTop(el[0].scrollHeight);
            }

            $('#sendBtn').on('click', function(e){
                e.preventDefault();
                var studentId = $('#currentStudentId').val();
                if (!studentId) { alert('Select a student first'); return; }
                var subject = $('#subjectCategory').val();
                var message = $('#messageText').val().trim();
                if (!message) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.post({
                    url: '/Lecture/Chat/SendMessage',
                    data: { __RequestVerificationToken: token, studentId: studentId, subjectCategory: subject, message: message },
                    success: function(resp){
                        if (resp && resp.success){
                            // append new bubble on right
                            var container = $('#messages');
                            var now = resp.timestamp;
                            var bubble = $('<div class="mb-3 d-flex">')
                                .append('<div class="bg-primary text-white rounded-3 shadow-sm p-3 ms-auto" style="max-width:70%">' + $('<div>').text(message).html() + '<div class="text-light small mt-2">' + now + '</div></div>');
                            container.append(bubble);
                            $('#messageText').val('');
                            scrollToBottom();
                        }
                    }
                });
            });

        })();
    </script>
}
