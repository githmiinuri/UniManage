@model UniManage3.Models.ViewModels.ChatIndexViewModel
@{
    ViewData["Title"] = "Student Communication";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h4 fw-semibold text-dark mb-1">Student-Lecturer Communication</h1>
            <p class="text-muted small mb-0">Reply to student inquiries and manage conversations from your modules.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden chat-shell" aria-label="Messaging workspace">
        <div class="row g-0 h-100">
            @* Left: Student directory *@
            <aside class="col-12 col-md-4 col-lg-3 bg-white border-end d-flex flex-column chat-directory" aria-label="Student directory">
                <header class="flex-shrink-0 bg-white p-3 border-bottom sticky-top" style="z-index: 2;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="directory-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true">
                            <i class="bi bi-people-fill"></i>
                        </span>
                        <div>
                            <h2 class="h6 fw-semibold mb-0 text-dark">Students</h2>
                            <p class="text-muted small mb-0">@Model.Students.Count enrolled</p>
                        </div>
                    </div>
                    <label for="searchBox" class="visually-hidden">Search students</label>
                    <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden mb-2">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input id="searchBox" type="search" class="form-control border-start-0 border-end-0" placeholder="Name or student ID..." autocomplete="off" />
                    </div>
                    <label for="batchFilter" class="visually-hidden">Filter by batch</label>
                    <select id="batchFilter" class="form-select form-select-sm rounded-3 shadow-sm">
                        <option value="">All batches</option>
                        @foreach (var b in Model.Batches)
                        {
                            <option value="@b.Id">@b.BatchName</option>
                        }
                    </select>
                </header>

                <div id="studentList" class="list-group list-group-flush flex-grow-1 overflow-auto" role="listbox" aria-label="Student list">
                    @if (!Model.Students.Any())
                    {
                        <div class="p-4 text-center text-muted small">
                            <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50" aria-hidden="true"></i>
                            No students enrolled in your modules yet.
                        </div>
                    }
                    @foreach (var s in Model.Students)
                    {
                        var initial = !string.IsNullOrEmpty(s.FullName) ? s.FullName.Trim()[0].ToString().ToUpperInvariant() : "?";
                        <button type="button"
                                class="list-group-item list-group-item-action border-0 rounded-0 contact-card py-3"
                                role="option"
                                data-student-id="@s.Id"
                                data-student-name="@s.FullName"
                                data-batch-id="@(s.BatchId?.ToString() ?? "")"
                                aria-selected="false">
                            <div class="d-flex align-items-center gap-3">
                                <span class="contact-avatar rounded-circle bg-primary-subtle text-primary fw-semibold d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true">@initial</span>
                                <span class="flex-grow-1 min-w-0 text-start">
                                    <span class="d-flex justify-content-between align-items-baseline gap-2">
                                        <span class="fw-semibold text-dark text-truncate">@s.FullName</span>
                                        <span class="badge text-bg-light text-muted fw-normal flex-shrink-0">#@s.Id</span>
                                    </span>
                                    <span class="text-muted small text-truncate d-block">@(string.IsNullOrWhiteSpace(s.NICNumber) ? "N/A" : s.NICNumber)</span>
                                </span>
                            </div>
                        </button>
                    }
                </div>
            </aside>

            @* Right: Conversation *@
            <section class="col-12 col-md-8 col-lg-9 bg-light d-flex flex-column chat-panel" aria-label="Conversation">
                <header class="flex-shrink-0 bg-white border-bottom px-3 py-3 d-flex align-items-center gap-3" id="chatHeaderBar">
                    <span id="chatHeaderAvatar" class="chat-header-avatar rounded-circle bg-secondary-subtle text-secondary d-none align-items-center justify-content-center flex-shrink-0" aria-hidden="true">?</span>
                    <div class="flex-grow-1 min-w-0">
                        <h2 id="chatHeader" class="h6 fw-semibold mb-0 text-dark text-truncate">Select a student</h2>
                        <p id="chatSubHeader" class="text-muted small mb-0 text-truncate">Choose someone from the directory to view their messages</p>
                    </div>
                    <span class="badge rounded-pill text-bg-light text-muted d-none d-md-inline-flex align-items-center gap-1" id="threadStatusBadge">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i> Ticket thread
                    </span>
                </header>

                <div id="chatBody" class="flex-grow-1 overflow-auto px-3 py-4 chat-messages" tabindex="0">
                    <div id="placeholder" class="h-100 d-flex flex-column align-items-center justify-content-center text-center text-muted px-3">
                        <div class="placeholder-icon rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center mb-3" aria-hidden="true">
                            <i class="bi bi-chat-left-text fs-1 text-primary opacity-75"></i>
                        </div>
                        <p class="fw-medium text-dark mb-1">Your messages will appear here</p>
                        <p class="small mb-0">Student inquiries show on the left; your replies appear on the right.</p>
                    </div>
                    <div id="messages" class="d-none" aria-live="polite" aria-relevant="additions"></div>
                </div>

                <footer class="flex-shrink-0 bg-white border-top p-3 chat-composer">
                    <form id="sendForm" class="d-flex flex-column gap-2" onsubmit="return false;" aria-label="Send reply">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="currentStudentId" name="studentId" />
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <label for="subjectCategory" class="visually-hidden">Subject category</label>
                            <select id="subjectCategory" name="subjectCategory" class="form-select form-select-sm rounded-3 shadow-sm" style="max-width: 11rem;" disabled>
                                <option value="0">General</option>
                                <option value="1">Assignment</option>
                                <option value="2">Grades</option>
                                <option value="3">Attendance</option>
                                <option value="99">Other</option>
                            </select>
                            <span class="text-muted small" id="composerHint">Select a student to reply</span>
                        </div>
                        <div class="input-group shadow-sm rounded-3 overflow-hidden">
                            <label for="messageText" class="visually-hidden">Message</label>
                            <textarea id="messageText"
                                      class="form-control border-0 py-2 px-3"
                                      rows="1"
                                      placeholder="Type your reply..."
                                      disabled
                                      maxlength="4000"></textarea>
                            <button type="button" id="sendBtn" class="btn btn-primary px-3 border-0 rounded-0" disabled aria-label="Send message">
                                <i class="bi bi-send-fill" aria-hidden="true"></i>
                            </button>
                        </div>
                    </form>
                </footer>
            </section>
        </div>
    </div>
</div>

<style>
    /* Scoped chat workspace - Modern Academic Portal */
    .chat-shell {
        height: 85vh;
        min-height: 32rem;
        max-height: calc(100vh - 10rem);
    }

    .chat-directory {
        min-height: 0;
        max-height: 100%;
    }

    .chat-panel {
        min-height: 0;
    }

    .directory-avatar {
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1.1rem;
    }

    .contact-avatar {
        width: 2.75rem;
        height: 2.75rem;
        font-size: 1rem;
    }

    .chat-header-avatar {
        width: 2.5rem;
        height: 2.5rem;
        font-size: 1rem;
        font-weight: 600;
    }

    .chat-header-avatar.is-visible {
        display: inline-flex !important;
    }

    .contact-card {
        transition: background-color 0.15s ease;
    }

    .contact-card:hover,
    .contact-card:focus-visible {
        background-color: var(--bs-light) !important;
    }

    .contact-card.active {
        background-color: var(--bs-primary-bg-subtle) !important;
        border-inline-start: 3px solid var(--bs-primary) !important;
        padding-inline-start: calc(1rem - 3px) !important;
    }

    .chat-messages {
        background-color: #eef1f4;
        background-image: radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.04) 1px, transparent 0);
        background-size: 24px 24px;
    }

    .placeholder-icon {
        width: 5rem;
        height: 5rem;
    }

    .msg-row {
        display: flex;
        margin-bottom: 0.75rem;
    }

    .msg-row--student {
        justify-content: flex-start;
    }

    .msg-row--lecturer {
        justify-content: flex-end;
    }

    .msg-bubble {
        max-width: min(75%, 28rem);
        padding: 0.65rem 0.9rem;
        border-radius: 1rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
        word-wrap: break-word;
    }

    .msg-bubble--student {
        background: #fff;
        color: var(--bs-body-color);
        border-bottom-left-radius: 0.25rem;
    }

    .msg-bubble--lecturer {
        background: var(--bs-primary);
        color: #fff;
        border-bottom-right-radius: 0.25rem;
    }

    .msg-meta {
        font-size: 0.7rem;
        opacity: 0.85;
        margin-top: 0.35rem;
    }

    .msg-subject {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
        opacity: 0.9;
    }

    .msg-bubble--student .msg-subject {
        color: var(--bs-primary);
    }

    .msg-bubble--lecturer .msg-subject {
        color: rgba(255, 255, 255, 0.9);
    }

    .thread-day-separator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1rem 0;
        color: var(--bs-secondary);
        font-size: 0.75rem;
        font-weight: 500;
    }

    .thread-day-separator::before,
    .thread-day-separator::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(0, 0, 0, 0.08);
    }

    .chat-composer textarea {
        resize: none;
        max-height: 8rem;
    }

    .chat-composer textarea:disabled {
        background: var(--bs-light);
    }

    @@media (max-width: 767.98px) {
        .chat-shell {
            height: auto;
            min-height: 70vh;
        }

        .chat-directory {
            max-height: 40vh;
            border-end: none !important;
            border-bottom: 1px solid var(--bs-border-color) !important;
        }

        .chat-panel {
            min-height: 50vh;
        }
    }
</style>

@section Scripts {
    <script>
        (function () {
            var getThreadUrl = '@Url.Action("GetChatThread", "Chat")';
            var sendMessageUrl = '@Url.Action("SendMessage", "Chat")';

            var $searchBox = $('#searchBox');
            var $batchFilter = $('#batchFilter');
            var $studentList = $('#studentList');
            var $chatHeader = $('#chatHeader');
            var $chatSubHeader = $('#chatSubHeader');
            var $chatHeaderAvatar = $('#chatHeaderAvatar');
            var $placeholder = $('#placeholder');
            var $messages = $('#messages');
            var $chatBody = $('#chatBody');
            var $currentStudentId = $('#currentStudentId');
            var $messageText = $('#messageText');
            var $sendBtn = $('#sendBtn');
            var $subjectCategory = $('#subjectCategory');
            var $composerHint = $('#composerHint');

            function escapeHtml(text) {
                return $('<div>').text(text || '').html();
            }

            function subjectLabel(subject) {
                if (!subject) return 'General';
                return String(subject).replace(/([A-Z])/g, ' $1').trim();
            }

            function setComposerEnabled(enabled) {
                $messageText.prop('disabled', !enabled);
                $sendBtn.prop('disabled', !enabled);
                $subjectCategory.prop('disabled', !enabled);
                $composerHint.text(enabled ? 'Replies are sent to the open ticket or a new thread' : 'Select a student to reply');
            }

            function filterList() {
                var q = ($searchBox.val() || '').toLowerCase().trim();
                var batch = $batchFilter.val();
                $('.contact-card').each(function () {
                    var $el = $(this);
                    var name = String($el.data('student-name') || '').toLowerCase();
                    var id = String($el.data('student-id') || '');
                    var studentBatch = String($el.data('batch-id') || '');
                    var keep = true;
                    if (q && name.indexOf(q) === -1 && id.indexOf(q) === -1) keep = false;
                    if (batch && studentBatch && studentBatch !== batch) keep = false;
                    $el.toggle(keep);
                });
            }

            $searchBox.on('input', filterList);
            $batchFilter.on('change', filterList);

            function scrollToBottom() {
                var el = $chatBody[0];
                if (el) el.scrollTop = el.scrollHeight;
            }

            function setHeader(studentName) {
                var initial = studentName ? studentName.trim().charAt(0).toUpperCase() : '?';
                $chatHeader.text(studentName || 'Select a student');
                $chatSubHeader.text(studentName
                    ? 'Student in your modules - ticket-based thread'
                    : 'Choose someone from the directory to view their messages');
                $chatHeaderAvatar.text(initial).addClass('is-visible');
            }

            function buildBubble(role, text, meta, subject) {
                var isLecturer = role === 'lecturer';
                var rowClass = isLecturer ? 'msg-row--lecturer' : 'msg-row--student';
                var bubbleClass = isLecturer ? 'msg-bubble--lecturer' : 'msg-bubble--student';
                var $row = $('<div class="msg-row ' + rowClass + '">');
                var $bubble = $('<div class="msg-bubble shadow-sm ' + bubbleClass + '">');
                if (subject) {
                    $bubble.append('<div class="msg-subject">' + escapeHtml(subjectLabel(subject)) + '</div>');
                }
                $bubble.append('<div class="msg-body">' + escapeHtml(text) + '</div>');
                if (meta) {
                    $bubble.append('<div class="msg-meta">' + escapeHtml(meta) + '</div>');
                }
                $row.append($bubble);
                return $row;
            }

            function dayKey(isoLike) {
                if (!isoLike) return '';
                return String(isoLike).split(' ')[0] || '';
            }

            function renderMessages(messages) {
                $messages.empty();
                if (!messages || messages.length === 0) {
                    $messages.append(
                        '<div class="text-center text-muted py-4">' +
                        '<i class="bi bi-chat-square-dots fs-3 d-block mb-2 opacity-50" aria-hidden="true"></i>' +
                        '<p class="mb-0 small">No tickets yet. Send the first reply below.</p></div>'
                    );
                    scrollToBottom();
                    return;
                }

                if (!Array.isArray(messages)) {
                    try { messages = JSON.parse(JSON.stringify(messages)); } catch (e) { messages = []; }
                }

                var lastDay = '';
                messages.forEach(function (m) {
                    var sentDay = dayKey(m.SentAt);
                    if (sentDay && sentDay !== lastDay) {
                        $messages.append('<div class="thread-day-separator"><span>' + escapeHtml(sentDay) + '</span></div>');
                        lastDay = sentDay;
                    }

                    var subject = m.Subject;
                    var studentText = (m.Message || '').trim();
                    var lecturerText = (m.Reply || '').trim();

                    if (studentText) {
                        $messages.append(buildBubble('student', studentText, m.SentAt || '', subject));
                    }
                    if (lecturerText) {
                        var replyMeta = m.RepliedAt || m.SentAt || '';
                        $messages.append(buildBubble('lecturer', lecturerText, replyMeta, subject));
                    }
                });

                scrollToBottom();
            }

            $studentList.on('click', '.contact-card', function () {
                var $card = $(this);
                $('.contact-card').removeClass('active').attr('aria-selected', 'false');
                $card.addClass('active').attr('aria-selected', 'true');

                var studentId = $card.data('student-id');
                var studentName = $card.data('student-name');
                $currentStudentId.val(studentId);
                setHeader(studentName);
                setComposerEnabled(true);
                $placeholder.addClass('d-none');
                $messages.removeClass('d-none').html(
                    '<div class="text-center text-muted py-5">' +
                    '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>' +
                    '<span class="visually-hidden">Loading</span>' +
                    '<p class="small mt-2 mb-0">Loading conversation...</p></div>'
                );

                $.get(getThreadUrl, { studentId: studentId })
                    .done(function (data) { renderMessages(data); })
                    .fail(function (xhr) {
                        console.error('Failed to load thread', xhr);
                        $messages.html('<div class="alert alert-danger rounded-3 shadow-sm small mb-0">Could not load this conversation. Please try again.</div>');
                    });
            });

            function sendMessage() {
                var studentId = $currentStudentId.val();
                if (!studentId) return;

                var subject = $subjectCategory.val();
                var message = ($messageText.val() || '').trim();
                if (!message) return;

                var token = $('input[name="__RequestVerificationToken"]').val();
                $sendBtn.prop('disabled', true);

                $.post({
                    url: sendMessageUrl,
                    data: {
                        __RequestVerificationToken: token,
                        studentId: studentId,
                        subjectCategory: subject,
                        message: message
                    }
                })
                    .done(function (resp) {
                        if (resp && resp.success) {
                            var subjectText = $subjectCategory.find('option:selected').text();
                            $messages.append(buildBubble('lecturer', message, resp.timestamp || '', subjectText));
                            $messageText.val('').css('height', 'auto');
                            scrollToBottom();
                        } else {
                            alert('Failed to send message.');
                        }
                    })
                    .fail(function (xhr) {
                        console.error('Send failed', xhr);
                        alert('Failed to send message.');
                    })
                    .always(function () {
                        $sendBtn.prop('disabled', !$currentStudentId.val());
                    });
            }

            $sendBtn.on('click', function (e) {
                e.preventDefault();
                sendMessage();
            });

            $messageText.on('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            $messageText.on('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 128) + 'px';
            });

            setComposerEnabled(false);
        })();
    </script>
}
