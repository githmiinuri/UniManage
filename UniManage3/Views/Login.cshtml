

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - UniManage</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="" crossorigin="anonymous">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root{
            /* modern blue-purple gradient for the page (card remains white) */
            --bg: linear-gradient(135deg,#071124 0%, #0b4f8a 45%, #6d28d9 100%);
            --sapphire: #0b4f8a; /* Sapphire Nightfall (deep) */
            --whisper: #6ea8fe; /* Whisper Blue (soft) */
            --crimson: #b22222; /* Crimson Red for hover */
            --card-shadow: 0 10px 30px rgba(0,0,0,0.05);
            --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
        }

        html,body{height:100%;}
        body{
            margin:0;
            font-family: var(--font-stack);
            background:var(--bg);
            -webkit-font-smoothing:antialiased;
            -moz-osx-font-smoothing:grayscale;
            position:relative;
            overflow:hidden;
        }

        /* Background artistic splotches */
        .splotch{
            position:absolute;
            width:420px;
            height:420px;
            border-radius:50%;
            filter:blur(80px);
            opacity:0.10;
            transform:translateZ(0);
            pointer-events:none;
        }
        .splotch.s1{ background: radial-gradient(circle at 30% 30%, rgba(11,79,138,1), rgba(11,79,138,0.6)); top:-80px; left:-120px; }
        .splotch.s2{ background: radial-gradient(circle at 70% 40%, rgba(110,168,254,1), rgba(110,168,254,0.6)); top:40px; right:-100px; }
        .splotch.s3{ background: radial-gradient(circle at 20% 80%, rgba(8,50,99,1), rgba(8,50,99,0.5)); bottom:-140px; left:-60px; width:520px; height:520px; }
        .splotch.s4{ background: radial-gradient(circle at 80% 70%, rgba(140,185,255,1), rgba(140,185,255,0.5)); bottom:20px; right:-140px; width:360px; height:360px; }

        /* Centering container */
        .auth-viewport{
            min-height:100vh;
            display:flex;
            align-items:center;
            justify-content:center;
            padding:2rem;
        }

        .auth-card{
            width:100%;
            max-width:420px;
            background:#fff;
            border-radius:12px;
            box-shadow:var(--card-shadow);
            padding:2rem;
            padding-top:2.5rem; /* extra top space so logo sits half-out/half-in */
            position:relative;
            overflow:hidden; /* clip wave SVGs to the card border */
        }

        /* logo sits centered at top, half outside the card */
        .logo-wrap{position:absolute;left:50%;top:-64px;transform:translateX(-50%);display:flex;justify-content:center;margin-bottom:0;z-index:3}
        .brand-title{color:var(--sapphire);font-weight:600;font-size:1.25rem;margin-top:0.5rem}
        .brand-sub{color:#6c757d;font-size:.9rem}

        /* Card wave decorations */
        /* Waves are full-width inside the card and clipped by the card's border-radius */
        .card-waves{position:absolute;left:0;width:100%;height:96px;overflow:hidden;pointer-events:none;z-index:0}
        .card-waves svg{display:block;width:100%;height:100%;}
        .card-waves.top{top:0}
        .card-waves.bottom{bottom:0}

        /* keep all main card children above the waves */
        .auth-card > :not(.card-waves){position:relative;z-index:2}
        .auth-card .btn{position:relative;z-index:3}

        /* Iconography and typography accent colors */
        .brand-sub{color:rgba(110,168,254,0.95)}
        .input-group-text i{color:rgba(110,168,254,0.95);font-size:1rem}
        .form-check-label{color:rgba(110,168,254,0.9)}
        .auth-card .brand-title{color:var(--sapphire)}

        .form-control:focus{box-shadow:none;border-color:rgba(106,153,255,0.6)}

        .btn-primary-gradient{
            background:linear-gradient(90deg,var(--sapphire),var(--whisper));
            color:#fff;border:none;padding:.75rem 1rem;border-radius:.5rem;
            transition:all .15s ease-in-out;box-shadow:0 6px 18px rgba(110,168,254,0.12);
        }
        /* On hover only invert the text color; keep the button background gradient */
        .btn-primary-gradient:hover{color:#000;box-shadow:0 6px 20px rgba(0,0,0,0.06)}

        .social-btn{
            width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;border:none;color:#fff;
        }
        .social-sep{display:flex;align-items:center;gap:.5rem;margin:1rem 0}
        .social-sep .line{flex:1;height:1px;background:rgba(0,0,0,0.08)}

        .footer-note{font-size:.9rem;color:#495057;margin-top:1rem;text-align:center}

        @@media (max-width:420px){
            .auth-card{padding:1.25rem;border-radius:10px}
        }
    </style>
</head>
<body>

    <div class="splotch s1" aria-hidden="true"></div>
    <div class="splotch s2" aria-hidden="true"></div>
    <div class="splotch s3" aria-hidden="true"></div>
    <div class="splotch s4" aria-hidden="true"></div>

    <main class="auth-viewport">
        <div class="card-container" style="position:relative; width:100%; max-width:420px;">
            <div class="logo-wrap">
                <!-- SVG U with academic cap -->
                <div style="background:#fff;border-radius:12px;padding:12px;box-shadow:0 6px 18px rgba(11,79,138,0.12);">
                    <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="64" height="64" rx="12" fill="white"/>
                        <path d="M32 4 L12 14 L32 24 L52 14 L32 4 Z" fill="var(--sapphire)"/>
                        <path d="M20 30 C24 34, 28 36, 32 36 C36 36,40 34,44 30 V46 C44 50,40 54,32 54 C24 54,20 50,20 46 V30 Z" fill="var(--whisper)" opacity="0.95"/>
                        <path d="M32 34 C28 34,24 32,20 28" stroke="rgba(11,79,138,0.9)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                        <path d="M14 20 L32 30 L50 20" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.6"/>
                    </svg>
                </div>
            </div>

            <div class="auth-card">
                <div class="card-waves top" aria-hidden="true">
                    <!-- center-right inspired waves, stronger colors -->
                    <svg viewBox="0 0 600 96" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 36 C120 8 240 60 360 38 C440 24 520 14 600 30 L600 0 L0 0 Z" fill="#6ea8fe"></path>
                        <path d="M0 22 C160 48 260 6 420 30 C520 46 560 26 600 8 L600 0 L0 0 Z" fill="#1a6ea8" opacity="0.9"></path>
                    </svg>
                </div>

                <div class="text-center mt-3 mb-4">
                <div class="brand-title">UniManage Portal</div>
                <div class="brand-sub">Streamlining Academic Excellence</div>
            </div>

            <form method="post" action="#" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label visually-hidden">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white" aria-hidden="true">
                            <!-- inline SVG user icon, blue accent -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z" stroke="#6ea8fe" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M4 20c0-3.314 2.686-6 6-6h4c3.314 0 6 2.686 6 6" stroke="#0b4f8a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <input id="username" name="username" type="text" class="form-control" placeholder="Username or email" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label visually-hidden">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white" aria-hidden="true">
                            <!-- inline shield SVG to match password context -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M12 2l7 4v6c0 5-3.5 9-7 10-3.5-1-7-5-7-10V6l7-4z" stroke="#6ea8fe" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                            </svg>
                        </span>
                        <!-- show typed text by default per user request -->
                        <input id="password" name="password" type="text" class="form-control" placeholder="Password" required>
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword" aria-label="Toggle password visibility" title="Hide password">
                            <!-- eye (hidden) - initially hidden from view (d-none) because text is visible) -->
                            <svg class="eye d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" stroke="#495057" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                <circle cx="12" cy="12" r="3" stroke="#495057" stroke-width="1.2" fill="none"/>
                            </svg>
                            <!-- eye-slash (visible) - indicates clicking will hide -->
                            <svg class="eye-slash" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M17.94 17.94A10.06 10.06 0 0112 19c-6 0-10-7-10-7a19.7 19.7 0 014.12-4.8" stroke="#495057" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                <path d="M1 1l22 22" stroke="#495057" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="remember">
                        <label class="form-check-label" for="remember">Remember me</label>
                    </div>
                    <div>
                        <a href="#" class="link-primary">Forgot Password?</a>
                    </div>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-primary-gradient">Login</button>
                </div>

                <div class="mb-2 text-center small">
                    <span class="text-muted">New to UniManage? Create your account </span><a href="/Account/Registration" class="text-decoration-none">here</a>.
                </div>
            </form>
                <div class="card-waves bottom" aria-hidden="true">
                    <svg viewBox="0 0 600 96" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0 56 C120 32 240 84 360 62 C440 48 520 38 600 54 L600 96 L0 96 Z" fill="#6ea8fe"></path>
                        <path d="M0 48 C160 76 260 34 420 58 C520 74 560 54 600 36 L600 96 L0 96 Z" fill="#1a6ea8" opacity="0.9"></path>
                    </svg>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>
    <script>
        (function(){
            var btn = document.getElementById('togglePassword');
            if (!btn) return;
            var input = document.getElementById('password');
            var eye = btn.querySelector('.eye');
            var eyeSlash = btn.querySelector('.eye-slash');
            btn.addEventListener('click', function(){
                if (input.type === 'password'){
                    // currently hidden, show as plain text
                    input.type = 'text';
                    if (eye) eye.classList.add('d-none');
                    if (eyeSlash) eyeSlash.classList.remove('d-none');
                    btn.title = 'Hide password';
                } else {
                    // currently visible, hide the text
                    input.type = 'password';
                    if (eye) eye.classList.remove('d-none');
                    if (eyeSlash) eyeSlash.classList.add('d-none');
                    btn.title = 'Show password';
                }
                input.focus();
            });
        })();
    </script>
</body>
</html>
