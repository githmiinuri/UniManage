@model UniManage3.Models.ViewModels.GradingViewModel

@{
    ViewData["Title"] = "Grade Submission";
}

<h1>Grade Submission</h1>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Details</h5>
                <p><strong>Student:</strong> @Model.StudentName</p>
                <p><strong>Assignment:</strong> @Model.AssignmentName</p>
                <p><strong>Submitted:</strong> @Model.SubmittedTime.ToString("yyyy-MM-dd HH:mm")</p>
                <p>
                    <strong>Status:</strong>
                    @if (Model.Status == UniManage3.Models.SubmissionStatus.OnTime)
                    {
                        <span class="badge bg-success">On Time</span>
                    }
                    else if (Model.Status == UniManage3.Models.SubmissionStatus.Late)
                    {
                        <span class="badge bg-danger">Late</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pending</span>
                    }
                </p>

                <a asp-controller="Submissions" asp-action="DownloadSubmission" asp-route-id="@Model.Id" class="btn btn-outline-primary">Download Submission</a>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Grading</h5>
                <form asp-controller="Submission" asp-action="GradeSubmission" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label">Marks</label>
                        <input asp-for="Marks" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Grade</label>
                        <input asp-for="Grade" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Review</label>
                        <textarea asp-for="Review" class="form-control" rows="5"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
