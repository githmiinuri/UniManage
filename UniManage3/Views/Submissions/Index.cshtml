@model UniManage3.Models.ViewModels.SubmissionListViewModel

@{
    ViewData["Title"] = "Submissions";
}

<div class="bg-light rounded-3 shadow-sm p-4 p-md-4 mb-4">
    <header class="mb-4">
        <h1 class="h3 fw-bold text-dark mb-1">Student submission review</h1>
        <p class="text-muted mb-0">Incoming assignments, downloads, and grading status at a glance.</p>
    </header>

    <div class="card bg-white border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h6 fw-semibold text-uppercase text-secondary mb-0">Filter inbox</h2>
            </div>
            <form method="get" class="d-flex flex-wrap align-items-end gap-2">
                <div class="flex-grow-1" style="min-width: 12rem; max-width: 22rem;">
                    <label class="form-label fw-semibold small mb-1" for="@Html.IdFor(m => m.SelectedBatchId)">Batch filter</label>
                    <select asp-for="SelectedBatchId" class="form-select rounded-3" asp-items="Model.Batches">
                        <option value="">All</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">Filter</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4" role="alert">@TempData["SuccessMessage"]</div>
    }

    <div class="card bg-white border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary fw-semibold">
                            <th class="ps-4 py-3">Student</th>
                            <th class="py-3">Assignment</th>
                            <th class="py-3">Batch</th>
                            <th class="py-3">Submitted</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Marks</th>
                            <th class="py-3">Grade</th>
                            <th class="py-3">Review</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top border-light">
                        @foreach (var s in Model.Submissions)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@(s.Student?.FullName ?? "Unknown")</td>
                                <td>@(s.Assignment?.AssignmentName ?? "Unknown")</td>
                                <td class="text-secondary">@(s.Assignment?.Batch?.BatchName ?? "-")</td>
                                <td class="text-nowrap text-secondary small">@s.SubmittedTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (s.Status == UniManage3.Models.SubmissionStatus.OnTime)
                                    {
                                        <span class="badge rounded-pill bg-success">On Time</span>
                                    }
                                    else if (s.Status == UniManage3.Models.SubmissionStatus.Late)
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark">Late Submission</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (s.Marks.HasValue)
                                    {
                                        @s.Marks.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Pending Grading</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.Grade))
                                    {
                                        @s.Grade
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Pending Grading</span>
                                    }
                                </td>
                                <td class="text-secondary small">
                                    @if (!string.IsNullOrWhiteSpace(s.Review))
                                    {
                                        @s.Review
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Pending Grading</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex flex-column flex-sm-row gap-2 justify-content-end">
                                        <a asp-controller="Submissions" asp-action="DownloadSubmission" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                                            Download
                                        </a>
                                        <a asp-controller="Submissions" asp-action="GradeSubmission" asp-route-id="@s.Id" class="btn btn-sm btn-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                            Grade / Review
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
