@model UniManage3.Models.Course

@using Microsoft.AspNetCore.Mvc.Rendering

@{}<form id="courseForm" method="post" action="@Url.Action(Model.Id==0?"Create":"Edit","Courses")">

@Html.AntiForgeryToken()

@if(Model.Id!=0){<input type="hidden" name="Id" value="@Model.Id" />}

<div id="formErrors" class="text-danger mb-2" style="display:none"></div>

<style>
    /* Make all labels bold and black in the course form */
    #courseForm label { font-weight: bold; color: #000; }
    /* style specific label elements that are plain text (some labels are raw text) */
    #courseForm .mb-2 > label { font-weight: bold; color: #000; display:block; margin-bottom:6px }
</style>

<div class="mb-2">

<label>Course Code</label>

<input name="CourseCode" class="form-control" value="@Model.CourseCode" required />

</div>

<div class="mb-2">

<label>Course Name</label>

<input name="CourseName" class="form-control" value="@Model.CourseName" required />

</div>

<div class="mb-2">

<label>Description</label>

<textarea name="Description" class="form-control">@Model.Description</textarea>

</div>

<div class="mb-2">

<label>Credits</label>

<input name="Credits" type="number" min="1" class="form-control" value="@(Model.Credits)">

</div>

<div class="mb-2">

<label>Prerequisite</label>

<select name="PrerequisiteCourseId" class="form-control searchable-select">

<option value="">-- None --</option>

@if(ViewBag.PrerequisiteList!=null){

foreach(var it in (SelectList)ViewBag.PrerequisiteList){

@:<option value="@it.Value"@(it.Selected?" selected=\"selected\"":"")>@it.Text</option>

}

}

</select>

</div>

<div class="mb-2">

<label>Coordinator</label>

<select name="CoordinatorId" class="form-control searchable-select">

<option value="">-- Select Coordinator --</option>

@if(ViewBag.CoordinatorList!=null){

foreach(var it in (SelectList)ViewBag.CoordinatorList){

@:<option value="@it.Value"@(it.Selected?" selected=\"selected\"":"")>@it.Text</option>

}

}

</select>

</div>

<div class="mb-2">

<label>Department</label>

<select name="DepartmentId" class="form-control searchable-select">

<option value="">-- Select Department --</option>

@if(ViewBag.Departments!=null){

foreach(var it in (SelectList)ViewBag.Departments){

@:<option value="@it.Value"@(it.Selected?" selected=\"selected\"":"")>@it.Text</option>

}

}

</select>

</div>

<div class="mb-2">

    <label>Status</label>

    <select name="IsActive" class="form-control">

    @if(Model.IsActive){

    <option value="true" selected>Active</option>

    <option value="false">Inactive</option>

    } else {

    <option value="true">Active</option>

    <option value="false" selected>Inactive</option>

    }

    </select>

</div>

<!-- Modules have been decoupled from the course form. Module management moved to dedicated module screens. -->

<div style="display:flex;gap:8px;justify-content:flex-end">

<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

<button type="submit" class="btn btn-primary" id="courseSaveBtn">Save</button>

</div></form><script>

// prevent default non-AJAX submission from modals (function(){

var form = document.getElementById('courseForm');

if(!form) return;

form.addEventListener('submit', function(e){

// stop normal submission; handled by parent page JS

e.preventDefault();

e.stopPropagation();

});

})();

</script>
