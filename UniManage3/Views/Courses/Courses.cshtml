@model IEnumerable<UniManage3.Models.Course>
@using Microsoft.AspNetCore.Mvc.Rendering
@inject UniManage3.Data.ApplicationDbContext _db
@{
    Layout = "_Layout";
    ViewData["Title"] = "Course Management";
    var email = User?.Identity?.Name;
    var fullName = _db.Users.FirstOrDefault(u => u.Email == email)?.FullName ?? email ?? "Administrator";
}

<style>
:root{--gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);--sidebar-width:260px;--accent-blue:#0b4f8a;--muted:#6c757d;--card-shadow:0 8px 20px rgba(12,42,80,0.06);} 
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans","Liberation Sans",sans-serif;background:#f8fafc;color:#0b2b4a}
    .admin-shell {
        display: flex;
        min-height: 100vh
    }
    /* ensure submenu stacking and positioning */
    .has-submenu {
        position: relative
    }

        .has-submenu .submenu {
            position: relative;
            z-index: 5;
            pointer-events: auto
        }

        .has-submenu .submenu-toggle {
            z-index: 6
        }

    /* --- SIDEBAR STRUCTURE (Merged from Student Management) --- */
    .left-bar {
        width: var(--sidebar-width);
        background: var(--gradient);
        color: #eaf4ff;
        padding: 18px 12px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transition: width .25s ease-in-out
    }

        .left-bar.collapsed {
            width: var(--sidebar-collapsed)
        }

        .left-bar .logo-top {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px
        }

    .logo-mark {
        display: flex;
        align-items: center;
        gap: 10px
    }

        .logo-mark svg {
            background: transparent
        }

    .brand-name {
        font-weight: 700;
        color: #eafbff
    }

    .logo-username {
        font-size: .9rem;
        color: rgba(255,255,255,0.9);
        margin-top: 12px
    }

    .menu {
        margin-top: 20px
    }

        .menu .section {
            margin-bottom: 12px
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px;
            border-radius: 8px;
            color: rgba(255,255,255,0.92);
            text-decoration: none;
            margin-bottom: 6px
        }

            .menu a .icon {
                width: 26px;
                height: 26px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px
            }

            .menu a:hover {
                background: rgba(255,255,255,0.06);
                color: #eaf4ff
            }

            .menu a.active {
                background: rgba(255,255,255,0.12);
                box-shadow: var(--card-shadow)
            }

        .menu .small {
            font-size: .85rem;
            color: rgba(255,255,255,0.85)
        }

        .menu .sep {
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin: 12px 0;
            border-radius: 2px
        }

    .bottom-actions {
        position: absolute;
        bottom: 18px;
        left: 12px;
        right: 12px;
        padding-right: 8px
    }

        .bottom-actions a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border-radius: 8px;
            color: rgba(255,255,255,0.9);
            text-decoration: none
        }
    /* submenu styles */
    .has-submenu .submenu-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
        width: 100%;
    }

    .has-submenu .chev {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: rotate(0);
        transition: transform .18s ease
    }

    .has-submenu .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .22s ease,opacity .18s ease;
        padding-left: 36px;
        opacity: 0
    }

        .has-submenu .submenu a.sub-action {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 8px;
            border-radius: 6px;
            color: rgba(255,255,255,0.9);
            text-decoration: none;
            margin: 4px 0
        }

            .has-submenu .submenu a.sub-action .icon {
                width: 18px;
                height: 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                flex: 0 0 18px
            }

    .has-submenu.open .chev {
        transform: rotate(90deg)
    }

    .has-submenu.open .submenu {
        opacity: 1;
        max-height: 400px
    }
    /* style the submenu-toggle when it's a button so it matches links */
    .has-submenu .submenu-toggle {
        background: transparent;
        border: none;
        padding: 8px 10px;
        cursor: pointer;
        color: inherit;
        font: inherit;
        text-align: left;
        width: 100%;
        display: flex;
        align-items: center
    }

        .has-submenu .submenu-toggle.active {
            background: rgba(255,255,255,0.12);
            box-shadow: var(--card-shadow)
        }
    /* hide native scrollbar but allow programmatic scrolling */
    .menu-inner {
        max-height: calc(100vh - 240px);
        overflow: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .menu-inner::-webkit-scrollbar {
            display: none;
        }

    /* --- CONTENT AREA & DEPARTMENT SPECIFIC STYLES --- */
    .content-wrap {
        margin-left: var(--sidebar-width);
        flex: 1;
        padding: 28px;
        transition: margin-left .25s ease-in-out
    }

    .left-bar.collapsed + .content-wrap {
        margin-left: var(--sidebar-collapsed)
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--accent-blue);
    }

    .page-actions {
        display: flex;
        align-items: center;
        gap: 12px
    }

    .card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        box-shadow: var(--card-shadow);
    }
.counter-row{display:flex;gap:12px;margin-bottom:16px}
.counter{flex:0 0 180px;background:#fff;border-radius:10px;padding:12px;box-shadow:var(--card-shadow)}
.table{width:100%;border-collapse:collapse}
.table th,.table td{padding:10px;border-bottom:1px solid #eef3fb;text-align:left}
.btn{background:var(--accent-blue);color:white;padding:8px;border-radius:8px;border:none}
.btn-secondary{background:transparent;border:1px solid #e6eefc;padding:8px;border-radius:8px;color:var(--accent-blue)}
.actions button{margin-right:6px}
.search-bar{display:flex;gap:8px;margin-bottom:12px}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,0.4);display:none;align-items:center;justify-content:center}
.modal{background:white;border-radius:12px;padding:18px;max-width:720px;width:100%;box-shadow:var(--card-shadow)}
.searchable-select{width:100%;padding:8px;border-radius:8px;border:1px solid #e6eefc}
.tag-active{background:#e6f7ea;color:#0b6624;padding:6px 8px;border-radius:8px;font-weight:600}
.tag-inactive{background:#ffecec;color:#a70000;padding:6px 8px;border-radius:8px;font-weight:600}

    @@media (max-width: 900px) {
        .left-bar {
            position: relative;
            width: 100%;
            height: auto;
        }

        .content-wrap {
            margin-left: 0;
            padding: 12px;
        }
    }
</style>

<div class="admin-shell">
    <aside class="left-bar" id="leftBar">
        <div class="logo-top">
            <div class="logo-mark">
                <div style="width:56px;height:56px;border-radius:12px;background:white;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(11,79,138,0.12);">
                    <!-- exact login logo SVG -->
                    <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="64" height="64" rx="12" fill="white" />
                        <path d="M32 4 L12 14 L32 24 L52 14 L32 4 Z" fill="#0b4f8a" />
                        <path d="M20 30 C24 34, 28 36, 32 36 C36 36,40 34,44 30 V46 C44 50,40 54,32 54 C24 54,20 50,20 46 V30 Z" fill="#6ea8fe" opacity="0.95" />
                        <path d="M32 34 C28 34,24 32,20 28" stroke="#0b4f8a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                </div>
                <div class="brand-name">UniManage</div>
            </div>
        </div>
        <div class="logo-username" style="display:flex;align-items:center;gap:8px;margin-top:12px">
            <!-- profile icon + full name -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" style="flex:0 0 32px;border-radius:50%;background:rgba(255,255,255,0.06);padding:4px">
                <path d="M12 12a4 4 0 100-8 4 4 0 000 8z" stroke="#eaf4ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M4 20v-1c0-2.2 3.6-4 8-4s8 1.8 8 4v1" stroke="#eaf4ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div style="color:rgba(255,255,255,0.95);font-weight:600">@fullName</div>
        </div>

        <nav class="menu">
            <div class="menu-inner" id="menuInner">
                <div class="section">
                    <a href="/Admin/Index"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 13h8V3H3v10zM13 21h8v-6h-8v6zM13 3v6h8V3h-8zM3 21h8v-8H3v8z" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Dashboard</span></a>
                    <div class="has-submenu" tabindex="0" role="button">
                        <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="userMgmtSub" onclick="toggleSub(this)">
                            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM8 11c1.657 0 3-1.343 3-3S9.657 5 8 5 5 6.343 5 8s1.343 3 3 3zM8 13c-2.667 0-8 1.333-8 4v2h16v-2c0-2.667-5.333-4-8-4z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                            <span class="small">User Management</span>
                            <span class="chev" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#eaf4ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </span>
                        </button>

                        <div id="userMgmtSub" class="submenu" role="region" aria-hidden="true">
                            <a href="/Admin/StudentManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="14" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 8h8" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg>
                                </span>
                                <span class="small">Student Management</span>
                            </a>
                            <a href="/Admin/LecturerManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v6" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /><path d="M6 8c0 3 3 5 6 5s6-2 6-5" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 20v-1c0-2 4-3 8-3s8 1 8 3v1" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </span>
                                <span class="small">Lecturer Management</span>
                            </a>
                            <a href="/Admin/AdministratorManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l6 3v5c0 5-6 9-6 9s-6-4-6-9V5l6-3z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </span>
                                <span class="small">Administrator Management</span>
                            </a>
                        </div>
                    </div>
                    
                    

                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="7" r="4" stroke="#9fc8ff" stroke-width="1.2" /></svg></span><span class="small">Students</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z" stroke="#9fc8ff" stroke-width="1.2" /><path d="M4 20v-1c0-2.21 3.58-4 8-4s8 1.79 8 4v1" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Lecturers</span></a>
                    <a href="/Admin/Departments"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="16" height="16" rx="1" stroke="#9fc8ff" stroke-width="1.2" fill="none" /><path d="M8 20v-8h8v8" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M10 8v2M14 8v2" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span><span class="small">Departments</span></a>
                    <a href='@Url.Action("Index", "Courses")' class="active">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="4" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" />
                                <path d="M7 8h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" />
                            </svg>
                        </span>
                        <span class="small">Courses</span>
                    </a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 6h18" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" /><path d="M12 6v14" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" /></svg></span><span class="small">Classes</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 21h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span><span class="small">Events</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3h18v18H3z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Library</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3v18h18" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Enrollment Statistics</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#9fc8ff" stroke-width="1.0" /><path d="M7 7h10v10H7z" stroke="#9fc8ff" stroke-width="1.0" /></svg></span><span class="small">Reports</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l9 21H3L12 2z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Performance</span></a>
                    <a href="/Account/EditProfile"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /><path d="M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></span><span class="small">Edit Profile</span></a>
                </div>
            </div>
        </nav>

        <div style="position:absolute;left:12px;right:12px;bottom:18px">
            <div style="display:flex;flex-direction:column;gap:8px">
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" style="width:100%; height:40px; background:#ff4d4f; color:white; border-radius:8px; padding:0; border:none; display:flex; justify-content:center; align-items:center; text-align:center; cursor:pointer;">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <main class="content-wrap">
        <div class="page-header">
            <div>
                <div class="page-title">Course Management</div>
                <div class="text-muted">@DateTime.UtcNow.ToString("MMMM d, dddd")</div>
            </div>
            <div class="page-actions">
                <button id="btnCreate" class="btn">Create New Course</button>
            </div>
        </div>

        <div class="counter-row">
            <div class="counter card">
                <div class="small text-muted">Active Courses</div>
                <div style="font-weight:700;font-size:1.4rem;color:var(--accent-blue)">@(Model?.Count() ?? 0)</div>
            </div>
            <div class="counter card">
                <div class="small text-muted">Inactive Courses</div>
                <div style="font-weight:700;font-size:1.4rem;color:var(--accent-blue)">0</div>
            </div>
        </div>

        <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div class="search-bar">
                    <form method="get" action="@Url.Action("Index","Courses")" style="display:flex;gap:8px;align-items:center">
                        <input name="searchTerm" class="form-control" placeholder="Search by Course Name" value="@(ViewBag.SearchTerm ?? "")" style="min-width:360px;" />
                        <button class="btn" type="submit">Search</button>
                        <button type="button" id="btnRefresh" class="btn" onclick="window.location='@Url.Action("Index","Courses")'">Refresh</button>
                    </form>
                </div>
            </div>

            <div style="overflow:auto">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:60px">No</th>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Coordinator</th>
                            <th>Department</th>
                            <th>Credits</th>
                            <th>Prerequisite</th>
                            <th>Status</th>
                            <th style="width:280px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var rows = Model ?? Enumerable.Empty<UniManage3.Models.Course>(); var rownum = 0; }
                    @foreach(var c in rows)
                    {
                        rownum++;
                        // detect IsActive property if it exists
                        var isActive = true;
                        var prop = c.GetType().GetProperty("IsActive");
                        if (prop != null)
                        {
                            var val = prop.GetValue(c);
                            if (val is bool b) isActive = b;
                            else if (val is int iv) isActive = iv == 1;
                        }
                        <tr id="course-row-@c.Id">
                            <td>@rownum</td>
                            <td>@c.CourseCode</td>
                            <td>@c.CourseName</td>
                            <td>@(c.Coordinator?.User?.FullName ?? (c.Coordinator!=null?(c.Coordinator.FirstName+" "+c.Coordinator.LastName):"-"))</td>
                            <td>@c.Credits</td>
                            <td>@(c.PrerequisiteCourse?.CourseName ?? "-")</td>
                            <td>@(isActive ? Html.Raw("<span class=\"tag-active\">Active</span>") : Html.Raw("<span class=\"tag-inactive\">Inactive</span>"))</td>
                            <td class="actions d-flex gap-2" style="align-items:center;min-width:280px">
                                <button class="btn" data-action="edit" data-id="@c.Id">Edit</button>
                                <button class="btn" data-action="details" data-id="@c.Id">Details</button>
                                <button class="btn" data-action="modules" data-id="@c.Id" style="white-space:nowrap;min-width:88px">Add Modules</button>
                                <form method="post" asp-action="Delete" asp-controller="Courses" asp-route-id="@c.Id" style="display:inline-block;margin:0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<!-- Course modal -->
<div class="modal fade" id="courseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header" style="background:var(--accent-blue);color:white">
        <h5 class="modal-title" id="courseModalTitle">Course</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="courseModalBody">
        <!-- AJAX content -->
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
                document.addEventListener('DOMContentLoaded', function(){

           document.querySelectorAll('.submenu-toggle').forEach(function(btn){
               btn.addEventListener('click', function(e){
                   e.preventDefault();
                   e.stopPropagation();

                   var parent = btn.closest('.has-submenu');
                   if (!parent) return;

                   var submenu = parent.querySelector('.submenu');
                   var isOpen = !parent.classList.contains('open');

                   // Toggle Classes
                   parent.classList.toggle('open', isOpen);
                   btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

                   // Expansion Logic
                   if (submenu) {
                       if (isOpen) {
                           // Adding a small buffer (e.g., +100) ensures child items aren't clipped
                           submenu.style.maxHeight = submenu.scrollHeight + "px";
                           submenu.style.opacity = "1";
                       } else {
                           submenu.style.maxHeight = "0";
                           submenu.style.opacity = "0";
                       }
                       submenu.setAttribute('aria-hidden', !isOpen);
                   }

                   // Close other open submenus
                   document.querySelectorAll('.has-submenu').forEach(function(other){
                       if (other !== parent) {
                           other.classList.remove('open');
                           var otherSub = other.querySelector('.submenu');
                           if (otherSub) {
                               otherSub.style.maxHeight = "0";
                               otherSub.style.opacity = "0";
                           }
                       }
                   });
               });
           });
        });
        (function(){
            var courseModal = new bootstrap.Modal(document.getElementById('courseModal'));

            // initialize Select2 on any select with class .searchable-select after modal content is loaded
            function initSelect2Inside(container){
                if (typeof $().select2 !== 'function') return;
                container.querySelectorAll('.searchable-select').forEach(function(el){
                    try { $(el).select2({ dropdownParent: $(el).closest('.modal') }); } catch(e) { }
                });
            }

            // attempt to load Select2 CSS/JS if not already present
            (function ensureSelect2(){
                if (typeof $().select2 === 'function') return;
                var link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css';
                document.head.appendChild(link);
                var script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';
                script.onload = function(){ console.log('Select2 loaded'); };
                document.body.appendChild(script);
            })();

            function fetchPartial(url){
                return fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.text());
            }

            document.getElementById('btnCreate').addEventListener('click', function(){
                fetchPartial('@Url.Action("CreateModal","Courses")')
                    .then(html => { document.getElementById('courseModalBody').innerHTML = html; courseModal.show(); attachFormHandlers(); initSelect2Inside(document.getElementById('courseModalBody')); });
            });

            document.querySelectorAll('button[data-action]').forEach(function(btn){
                btn.addEventListener('click', function(){
                    var id = btn.getAttribute('data-id');
                    var action = btn.getAttribute('data-action');
                    if(action === 'edit'){
                        fetchPartial('@Url.Action("EditModal","Courses")' + '?id=' + id)
                            .then(html => { document.getElementById('courseModalBody').innerHTML = html; courseModal.show(); attachFormHandlers(); initSelect2Inside(document.getElementById('courseModalBody')); });
                    } else if(action === 'details'){
                        fetchPartial('@Url.Action("Details","Courses")' + '?id=' + id)
                            .then(html => { document.getElementById('courseModalBody').innerHTML = html; courseModal.show(); });
                    } else if(action === 'modules'){
                        fetchPartial('/Modules/Create?courseId=' + id).then(html => { document.getElementById('courseModalBody').innerHTML = html; courseModal.show(); attachFormHandlers(); initSelect2Inside(document.getElementById('courseModalBody')); });
                    }
                });
            });

            function attachFormHandlers(){
                // generic submit helper that handles JSON or HTML responses
                function submitAndHandle(form){
                    if(!form) return;
                    form.addEventListener('submit', function(e){
                        // ensure modal forms never perform a standard POST
                        e.preventDefault();
                        e.stopPropagation();
                        var fd = new FormData(form);
                        var url = form.getAttribute('action');
                        var headers = { 'X-Requested-With': 'XMLHttpRequest' };
                        var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]') || document.querySelector('input[name="__RequestVerificationToken"]');
                        if (tokenEl && tokenEl.value) headers['RequestVerificationToken'] = tokenEl.value;
                        fetch(url, { method: 'POST', body: fd, headers: headers })
                            .then(function(response){
                                var ct = response.headers.get('content-type') || '';
                                if (ct.indexOf('application/json') !== -1) return response.json();
                                return response.text();
                            })
                            .then(function(data){
                                // JSON success from controller
                                if (data && typeof data === 'object' && data.success) {
                                    var targetId = data.id || data.courseId;
                                    if (targetId) {
                                        fetch('@Url.Action("Row","Courses")' + '?id=' + targetId, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                                            .then(r => r.text()).then(html => {
                                                var temp = document.createElement('tbody');
                                                temp.innerHTML = html;
                                                var newRow = temp.querySelector('tr');
                                                var old = document.getElementById('course-row-' + targetId);
                                                if (old && newRow) old.replaceWith(newRow);
                                                else location.reload();
                                            }).finally(() => { courseModal.hide(); });
                                    } else {
                                        courseModal.hide();
                                        location.reload();
                                    }
                                    return;
                                }

                                // If data is HTML (validation errors), replace modal body
                                if (data && typeof data === 'string') {
                                    document.getElementById('courseModalBody').innerHTML = data;
                                    // re-attach handlers to any new forms
                                    attachFormHandlers();
                                    initSelect2Inside(document.getElementById('courseModalBody'));
                                    return;
                                }

                                // Fallback
                                location.reload();
                            }).catch(function(err){ console.error(err); location.reload(); });
                    });
                }

                // attach to course form
                submitAndHandle(document.getElementById('courseForm'));
                // attach to module form (if present)
                submitAndHandle(document.getElementById('moduleForm'));
            }

        })();
    </script>
}
