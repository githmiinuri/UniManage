@model UniManage3.Models.Assignment

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Assignment</h1>

<div class="alert alert-danger">
    <h4 class="alert-heading">This action is permanent</h4>
    <p>Deleting this assignment will also remove its uploaded brief file from the server (if present).</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.AssignmentName</h5>
        <p class="card-text">@Model.Description</p>
        <dl class="row">
            <dt class="col-sm-3">Issued</dt>
            <dd class="col-sm-9">@Model.IssuedDate.ToString("f")</dd>
            <dt class="col-sm-3">Deadline</dt>
            <dd class="col-sm-9">@Model.DeadlineDate.ToString("f")</dd>
            <dt class="col-sm-3">Module</dt>
            <dd class="col-sm-9">@Model.Module?.ModuleName</dd>
            <dt class="col-sm-3">Batch</dt>
            <dd class="col-sm-9">@(Model.Batch != null ? (Model.Batch.BatchName ?? Model.Batch.BatchCode) : "-")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete Permanently</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
