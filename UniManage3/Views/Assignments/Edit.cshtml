@model UniManage3.Models.AssignmentUploadViewModel

@{
    ViewData["Title"] = "Edit";
}

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-lg-5">
                    <p class="text-uppercase small fw-semibold text-muted mb-2" style="letter-spacing: .08em;">Update coursework</p>
                    <h1 class="h3 fw-bold text-dark mb-1">Edit assignment</h1>
                    <p class="text-muted small mb-4">Adjust deadlines, module, batch, or replace the PDF brief.</p>

                    <form asp-action="Edit" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3 d-none">
                            <label asp-for="ResourceFilePath" class="form-label"></label>
                            <input asp-for="ResourceFilePath" class="form-control" />
                        </div>

                        <div class="mb-3 d-none">
                            <label asp-for="UpdatedDate" class="form-label"></label>
                            <input asp-for="UpdatedDate" class="form-control" />
                        </div>

                        <div class="row g-3 mb-1">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AssignmentName" class="form-label fw-semibold"></label>
                                    <input asp-for="AssignmentName" class="form-control rounded-3" />
                                    <span asp-validation-for="AssignmentName" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label fw-semibold"></label>
                                    <textarea asp-for="Description" class="form-control rounded-3" rows="4"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ModuleId" class="form-label fw-semibold"></label>
                                    <select asp-for="ModuleId" class="form-select rounded-3" asp-items="ViewBag.ModuleId"></select>
                                    <span asp-validation-for="ModuleId" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-0">
                                    <label asp-for="BatchId" class="form-label fw-semibold">Batch</label>
                                    <select asp-for="BatchId" class="form-select rounded-3" asp-items="ViewBag.BatchId"></select>
                                    <span asp-validation-for="BatchId" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="IssuedDate" class="form-label fw-semibold"></label>
                                    <input asp-for="IssuedDate" type="datetime-local" class="form-control rounded-3" />
                                    <span asp-validation-for="IssuedDate" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="DeadlineDate" class="form-label fw-semibold"></label>
                                    <input asp-for="DeadlineDate" type="datetime-local" class="form-control rounded-3" />
                                    <span asp-validation-for="DeadlineDate" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="LateSubmitDate" class="form-label fw-semibold"></label>
                                    <input asp-for="LateSubmitDate" type="datetime-local" class="form-control rounded-3" />
                                    <span asp-validation-for="LateSubmitDate" class="text-danger small d-block mt-1"></span>
                                </div>
                                <div class="mb-3 p-3 bg-light rounded-3 border">
                                    <label class="form-label fw-semibold">Current Brief</label>
                                    @if (!string.IsNullOrEmpty(Model.ResourceFilePath))
                                    {
                                        <div class="mb-0">
                                            <a class="btn btn-outline-secondary btn-sm rounded-3 shadow-sm" asp-action="Download" asp-route-id="@Model.Id">Download current brief</a>
                                            <span class="ms-2 small text-muted">@System.IO.Path.GetFileName(Model.ResourceFilePath)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small mb-0">No file uploaded yet.</div>
                                    }
                                </div>
                                <div class="mb-0">
                                    <label asp-for="UploadedFile" class="form-label fw-semibold">Replace Brief (PDF)</label>
                                    <input asp-for="UploadedFile" type="file" class="form-control rounded-3" accept=".pdf" />
                                    <span asp-validation-for="UploadedFile" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-2 border-top">
                            <button type="submit" class="btn btn-primary rounded-3 shadow-sm px-4">Save assignment</button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
