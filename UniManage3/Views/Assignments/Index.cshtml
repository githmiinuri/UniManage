@model IEnumerable<UniManage3.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <p class="text-uppercase small fw-semibold text-muted mb-2" style="letter-spacing: .08em;">Coursework</p>
                        <h1 class="h2 fw-bold text-dark mb-1">Assignments</h1>
                        <p class="text-muted mb-0 small">Create deadlines, attach briefs, and link work to modules and batches.</p>
                    </div>
                    <a asp-action="Create" class="btn btn-primary btn-lg rounded-3 shadow-sm text-nowrap">Create new assignment</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Assignment</th>
                                    <th class="d-none d-xl-table-cell" style="max-width: 12rem;">Description</th>
                                    <th>Issued</th>
                                    <th>Deadline</th>
                                    <th class="d-none d-lg-table-cell">Late submit</th>
                                    <th class="d-none d-lg-table-cell">Updated</th>
                                    <th>Module</th>
                                    <th>Batch</th>
                                    <th class="pe-4 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@Html.DisplayFor(modelItem => item.AssignmentName)</td>
                                        <td class="d-none d-xl-table-cell text-muted small text-truncate" style="max-width: 12rem;">@Html.DisplayFor(modelItem => item.Description)</td>
                                        <td class="text-nowrap small">@item.IssuedDate.ToString("g")</td>
                                        <td class="text-nowrap small">@item.DeadlineDate.ToString("g")</td>
                                        <td class="d-none d-lg-table-cell text-nowrap small">@(item.LateSubmitDate.HasValue ? item.LateSubmitDate.Value.ToString("g") : "-")</td>
                                        <td class="d-none d-lg-table-cell text-nowrap small">@(item.UpdatedDate.HasValue ? item.UpdatedDate.Value.ToString("g") : "-")</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Module?.ModuleCode))
                                            {
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary me-1">@item.Module.ModuleCode</span>
                                            }
                                            <span class="small text-muted">@item.Module?.ModuleName</span>
                                        </td>
                                        <td>
                                            @if (item.Batch != null)
                                            {
                                                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary">@(item.Batch.BatchName ?? item.Batch.BatchCode)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="pe-4 text-end text-nowrap">
                                            @if (!string.IsNullOrEmpty(item.ResourceFilePath))
                                            {
                                                <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-3 shadow-sm me-1" title="Download brief">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                                                </a>
                                            }
                                            <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Assignment actions">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.086.13-.17.252-.254.369C12.795 10.206 11.107 11.5 8 11.5c-3.107 0-4.795-1.294-5.574-2.131-.084-.117-.168-.24-.253-.369z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
