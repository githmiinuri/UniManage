@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<style>
        :root{
            --gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);
            --sidebar-width: 260px;
            --sidebar-collapsed: 64px;
            --accent-blue: #0b4f8a;
            --light-blue: #9fc8ff;
            --muted: #6c757d;
            --card-shadow: 0 8px 20px rgba(12,42,80,0.06);
            --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
        }
        body{font-family:var(--font-stack);background:#f8fafc;color:#0b2b4a}
        .admin-shell{display:flex;min-height:100vh}
        /* left bar */
        .left-bar{width:var(--sidebar-width);background:var(--gradient);color:#eaf4ff;padding:18px 12px;position:fixed;left:0;top:0;bottom:0;transition:width .25s ease-in-out;overflow:hidden}
        .left-bar.collapsed{width:var(--sidebar-collapsed)}
        .left-bar .logo-top{display:flex;align-items:center;gap:8px;padding:6px 8px}
        .left-bar .logo-top .bars{margin-left:auto;cursor:pointer}
        .logo-mark{display:flex;align-items:center;gap:10px}
        .logo-mark svg{background:transparent}
        .brand-name{font-weight:700;color:#eafbff}
        .logo-username{font-size:.9rem;color:rgba(255,255,255,0.9);margin-top:12px}
        .menu{margin-top:20px}
        .menu .section{margin-bottom:12px}
        .menu a{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:8px;color:rgba(255,255,255,0.92);text-decoration:none;margin-bottom:6px}
        .menu a .icon{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:6px}
        .menu a:hover{background:rgba(255,255,255,0.06);color:#eaf4ff}
        .menu a.active{background:rgba(255,255,255,0.12);box-shadow:var(--card-shadow)}
        .menu .small{font-size:.85rem;color:rgba(255,255,255,0.85)}
        .menu .sep{height:1px;background:rgba(255,255,255,0.06);margin:12px 0;border-radius:2px}
        .bottom-actions{position:absolute;bottom:18px;left:12px;right:12px;padding-right:8px}
        .bottom-actions a{display:flex;align-items:center;gap:10px;padding:8px;border-radius:8px;color:rgba(255,255,255,0.9);text-decoration:none}
        .content-wrap{margin-left:var(--sidebar-width);flex:1;padding:28px;transition:margin-left .25s ease-in-out}
        .left-bar.collapsed + .content-wrap{margin-left:var(--sidebar-collapsed)}

        /* page header */
        .page-header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:18px}
        .page-title{font-size:1.4rem;font-weight:700;color:var(--accent-blue)}
        .page-actions{display:flex;align-items:center;gap:12px}
        .card{background:#fff;border-radius:12px;padding:16px;box-shadow:var(--card-shadow)}

        /* responsive */
        @@media (max-width:900px){
            .left-bar{position:relative;width:100%;height:auto}
            .content-wrap{margin-left:0;padding:12px}
        }
    </style>
    
    <!-- Admin page content (renders inside shared layout) -->
    <div class="admin-shell">
        <aside class="left-bar" id="leftBar">
            <div class="logo-top">
                <div class="logo-mark">
                    <div style="width:42px;height:42px;border-radius:10px;background:white;display:flex;align-items:center;justify-content:center">
