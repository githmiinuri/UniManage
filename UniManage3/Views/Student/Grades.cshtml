@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Grades & Feedback";
}

@* Applying the exact class hierarchy from your Admin styles:
   - page-header: ensures the layout follows the flex structure
   - page-title: applies the 1.4rem bold styling in --accent-blue
   - text-muted: applies the --muted color variable (#6c757d)
*@

<div class="page-header">
    <div>
        <div class="page-title">Grades & Feedback</div>
        <div class="text-muted">@DateTime.Now.ToString("MMMM d, dddd")</div>
    </div>

    <div class="page-actions">
        @* Future actions like 'Download Transcript' or 'GPA Calculator' can go here *@
    </div>
</div>

<div class="content-body">
    @* The rest of the page is kept empty for now per your instruction *@
    <div class="card border-0 shadow-sm p-4 mt-3">
        <div class="text-center py-5">
            <i class="fa-solid fa-chart-line fa-3x mb-3" style="color: var(--accent-blue); opacity: 0.15;"></i>
            <p class="text-muted">No grades or feedback have been published for the current semester yet.</p>
        </div>
    </div>
</div>