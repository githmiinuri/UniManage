@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Digital Library";
}

@* Implementing the exact CSS hierarchy from the Admin Side reference:
   - page-header: Handles alignment and spacing.
   - page-title: Styled with var(--accent-blue) and 1.4rem font size.
   - text-muted: Styled with var(--muted) for the current date string.
*@

<div class="page-header">
    <div>
        <div class="page-title">Digital Library</div>
        <div class="text-muted">@DateTime.Now.ToString("MMMM d, dddd")</div>
    </div>

    <div class="page-actions">
        @* Future actions like 'Borrowing History' or 'Search Catalog' will be placed here *@
    </div>
</div>

<div class="content-body">
    @* Content container kept empty per your instructions *@
    <div class="card border-0 shadow-sm p-5 mt-3">
        <div class="text-center py-5">
            <i class="fa-solid fa-book-open fa-3x mb-3" style="color: var(--accent-blue); opacity: 0.15;"></i>
            <p class="text-muted">The digital library catalog is currently being updated for the new semester.</p>
        </div>
    </div>
</div>
