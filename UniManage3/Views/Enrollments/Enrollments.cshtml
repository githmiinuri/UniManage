        <div style="position:absolute;left:12px;right:12px;bottom:18px">
            <div style="display:flex;flex-direction:column;gap:8px">
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" style="width:100%;background:#ff4d4f;color:white;border-radius:8px;padding:8px;border:none">Logout</button>
                </form>
            </div>
        </div>
    </aside>

    <main class="content-wrap">
        @Html.AntiForgeryToken()
        <header class="page-header">
            <div>
                <div class="page-title">Enrollment Management</div>
                <div style="font-size:0.85rem; color:var(--muted)">@CurrentDate()</div>
            </div>
           
        </header>

        <div class="counter-row">
            <div class="counter card">
                <div class="small text-muted">Pending Requests</div>
                <div class="value">@Model.PendingCount</div>
            </div>
            <div class="counter card">
                <div class="small text-muted">Approved</div>
                <div class="value">@Model.CompletedCount</div>
            </div>
            <div class="counter card">
                <div class="small text-muted">Rejected</div>
                <div class="value">@Model.FailedCount</div>
            </div>
        </div>

        <div class="card table-container" style="margin-top:16px">
            <form method="get" action="@Url.Action("Enrollments", "Enrollments")" style="margin-bottom:24px; display:flex; gap:12px;" class="search-bar">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search student name or course..." class="form-control" />
                <select name="status" class="searchable-select">
                    <option value="In-Progress" selected="@(Model.CurrentStatus == "In-Progress" || Model.CurrentStatus == "Pending")">Pending</option>
                    <option value="Completed" selected="@(Model.CurrentStatus == "Completed")">Completed</option>
                    <option value="Failed" selected="@(Model.CurrentStatus == "Failed")">Failed</option>
                </select>
                <button type="submit" class="btn">Filter</button>
            </form>

            <div class="table-wrapper" style="overflow:auto">
                <table class="table">
                <thead>
                    <tr>
                        <th>Student Details</th>
                        <th>Course Target</th>
                        <th>Applied On</th>
                        <th>Prerequisite</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Enrollments)
                    {
                        <tr id="row-@item.Id">
                            <td>
                                <div class="td-strong">@item.StudentName</div>
                                <div class="text-muted-small">@item.StudentEmail</div>
                            </td>
                            <td>
                                <div class="td-strong-600">@item.CourseCode</div>
                                <div class="text-muted-small">@item.CourseName</div>
                            </td>
                            <td class="td-date">@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="td-strong-600">@(!string.IsNullOrEmpty(item.PrerequisiteName) ? item.PrerequisiteName : "None")</div>
                            </td>
                            <td class="action-buttons" style="min-width:240px">
                                @if (Model.CurrentStatus == "In-Progress" || Model.CurrentStatus == "Pending")
                                {
                                    <div style="display:flex;gap:8px;align-items:center;white-space:nowrap">
                                        <button type="button" class="btn btn-approve" onclick="processEnrollment(@item.Id, 'Approve')">Approve</button>
                                        <button type="button" class="btn btn-reject" onclick="processEnrollment(@item.Id, 'Reject')">Reject</button>
                                    </div>
                                }
                                else
                                {
                                    <div style="display:flex;gap:8px;align-items:center;white-space:nowrap">
                                        <button type="button" class="btn btn-reject" onclick="processEnrollment(@item.Id, 'Delete')">Permanent Delete</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Enrollments.Any())
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding:40px; color:var(--muted)">No enrollment records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

   

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function processEnrollment(id, action) {
            if (!confirm(`Are you sure you want to ${action.toLowerCase()} this enrollment?`)) return;

            const url = `/Enrollments/${action}`;
            const token = $('input[name="__RequestVerificationToken"]').first().val();

            $.ajax({
                url: url,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'XSRF-TOKEN': token
                },
                data: {
                    id: id,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res && res.success) {
                        // Remove the row from the table
                        $('#row-' + id).remove();

                        // Update counters if provided (counter-row -> .counter .value)
                        if (res.pendingCount !== undefined) $('.counter-row .counter').eq(0).find('.value').text(res.pendingCount);
                        if (res.completedCount !== undefined) $('.counter-row .counter').eq(1).find('.value').text(res.completedCount);
                        if (res.failedCount !== undefined) $('.counter-row .counter').eq(2).find('.value').text(res.failedCount);

                        alert(res.message || 'Updated successfully.');
                    } else {
                        alert((res && res.message) || "An error occurred.");
                    }
                },
                error: function (xhr) {
                    // Try to show server-provided message when available
                    var msg = "Server error. Please ensure you are logged in as an Administrator.";
                    try {
                        var json = JSON.parse(xhr.responseText);
                        if (json && json.message) msg = json.message;
                    } catch (e) { }
                    alert(msg);
                }
            });
        }
    </script>
}
