@using UniManage3.ViewModels
@model EnrollmentManagementViewModel
@inject UniManage3.Data.ApplicationDbContext _db
@{
    Layout = "_Layout";
    ViewData["Title"] = "Enrollment Management";
    var email = User?.Identity?.Name;
    var fullName = _db.Users.FirstOrDefault(u => u.Email == email)?.FullName ?? email ?? "Administrator";
}

@functions {
    public string CurrentDate() => DateTime.UtcNow.ToString("MMMM d, dddd");
}

<style>
    :root {
        /* Department page aligned variables */
        --gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);
        --sidebar-width: 260px;
        --sidebar-collapsed: 64px;
        /* Department Blue accent (exact hex from Departments page) */
        --accent-blue: #0b4f8a;
        --light-blue: #9fc8ff;
        --muted: #6c757d;
        --card-shadow: 0 8px 20px rgba(12,42,80,0.06);
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
    }

    body {
        font-family: var(--font-stack);
        background: #f8fafc;
        color: #0b2b4a
    }

    .admin-shell {
        display: flex;
        min-height: 100vh
    }
    /* ensure submenu stacking and positioning */
    .has-submenu {
        position: relative
    }

        .has-submenu .submenu {
            position: relative;
            z-index: 5;
            pointer-events: auto
        }

        .has-submenu .submenu-toggle {
            z-index: 6
        }
    /* left bar */
    .left-bar {
        width: var(--sidebar-width);
        background: var(--gradient);
        color: #eaf4ff;
        padding: 18px 12px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transition: width .25s ease-in-out
    }

        .left-bar.collapsed {
            width: var(--sidebar-collapsed)
        }

        .left-bar .logo-top {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px
        }

    .logo-mark {
        display: flex;
        align-items: center;
        gap: 10px
    }

        .logo-mark svg {
            background: transparent
        }

    .brand-name {
        font-weight: 700;
        color: #eafbff
    }

    .logo-username {
        font-size: .9rem;
        color: rgba(255,255,255,0.9);
        margin-top: 12px
    }

    .menu {
        margin-top: 20px
    }

        .menu .section {
            margin-bottom: 12px
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px;
            border-radius: 8px;
            color: rgba(255,255,255,0.92);
            text-decoration: none;
            margin-bottom: 6px
        }

            .menu a .icon {
                width: 26px;
                height: 26px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px
            }

            .menu a:hover {
                background: rgba(255,255,255,0.06);
                color: #eaf4ff
            }

            .menu a.active {
                background: rgba(255,255,255,0.12);
                box-shadow: var(--card-shadow)
            }

        .menu .small {
            font-size: .85rem;
            color: rgba(255,255,255,0.85)
        }

        .menu .sep {
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin: 12px 0;
            border-radius: 2px
        }

    .bottom-actions {
        position: absolute;
        bottom: 18px;
        left: 12px;
        right: 12px;
        padding-right: 8px
    }

        .bottom-actions a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border-radius: 8px;
            color: rgba(255,255,255,0.9);
            text-decoration: none
        }
    /* submenu styles */
    .has-submenu .submenu-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
        width: 100%;
    }

    .has-submenu .chev {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: rotate(0);
        transition: transform .18s ease
    }

    .has-submenu .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .22s ease,opacity .18s ease;
        padding-left: 36px;
        opacity: 0
    }

        .has-submenu .submenu a.sub-action {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 8px;
            border-radius: 6px;
            color: rgba(255,255,255,0.9);
            text-decoration: none;
            margin: 4px 0
        }

            .has-submenu .submenu a.sub-action .icon {
                width: 18px;
                height: 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                flex: 0 0 18px
            }

    .has-submenu.open .chev {
        transform: rotate(90deg)
    }

    .has-submenu.open .submenu {
        opacity: 1;
        max-height: 400px
    }
    /* style the submenu-toggle when it's a button so it matches links */
    .has-submenu .submenu-toggle {
        background: transparent;
        border: none;
        padding: 8px 10px;
        cursor: pointer;
        color: inherit;
        font: inherit;
        text-align: left;
        width: 100%;
        display: flex;
        align-items: center
    }

        .has-submenu .submenu-toggle.active {
            background: rgba(255,255,255,0.12);
            box-shadow: var(--card-shadow)
        }
    /* hide native scrollbar but allow programmatic scrolling */
    .menu-inner {
        max-height: calc(100vh - 240px);
        overflow: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .menu-inner::-webkit-scrollbar {
            display: none;
        }

    .content-wrap {
        margin-left: var(--sidebar-width);
        flex: 1;
        padding: 28px;
        transition: margin-left .25s ease-in-out
    }

    /* make content-wrap internally scrollable while body remains fixed */
        .content-wrap { height: 100vh; overflow-y: auto; -webkit-overflow-scrolling: touch; padding-bottom: 56px; }
    .content-wrap::-webkit-scrollbar { width: 0px; background: transparent; }
    .content-wrap { -ms-overflow-style: none; scrollbar-width: none; }

    /* table wrapper sizing to keep footer visible via internal scroll */
    .table-container .table-wrapper { max-height: calc(100vh - 420px); overflow-x: auto; overflow-y: auto; -webkit-overflow-scrolling: touch; }

    .left-bar.collapsed + .content-wrap {
        margin-left: var(--sidebar-collapsed)
    }

    /* page header */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--accent-blue)
    }

    .page-actions {
        display: flex;
        align-items: center;
        gap: 12px
    }

    .card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        box-shadow: var(--card-shadow)
    }

    /* responsive */
    /* Department-like component additions (counters, inputs, buttons) */
    .counter-row { display:flex; gap:12px; margin-bottom:16px }
    .counter { flex:0 0 180px; background:#fff; border-radius:10px; padding:12px; box-shadow:var(--card-shadow); border:1px solid #eef3fb; }
    .counter .small { color:var(--muted); font-size:0.9rem }
    .counter .value { font-weight:700; font-size:1.4rem; color:var(--accent-blue) }

    /* Table typography utilities */
    .td-strong { font-weight:700; color:#0b2b4a }
    .td-strong-600 { font-weight:600; color:#0b2b4a }
    .td-date { font-size:0.9rem }
    .action-buttons { display:flex; gap:8px; align-items:center; white-space:nowrap }
    .text-muted-small { color:var(--muted); font-size:0.85rem }

    /* Inputs & selects matching Departments */
    .form-control, .searchable-select { padding:10px 12px; border-radius:10px; border:1px solid #e6eefc; height:42px; font-family:var(--font-stack); font-size:0.95rem }
    .form-control::placeholder { color:var(--muted) }
    .form-control:focus, .searchable-select:focus { border-color:var(--accent-blue); box-shadow:0 0 0 3px rgba(11,79,138,0.06); outline:none }

    /* Buttons */
    .btn { background:var(--accent-blue); color:white; padding:8px 16px; border-radius:8px; border:none; cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-weight:600 }
    .btn-secondary { background:transparent; border:1px solid #e6eefc; padding:8px 16px; border-radius:8px; color:var(--accent-blue) }
    .btn:hover { background: color-mix(in srgb, var(--accent-blue) 88%, black 12%); color:black }

    @@media (max-width:900px) {
        .left-bar {
            position: relative;
            width: 100%;
            height: auto
        }

        .content-wrap {
            margin-left: 0;
            padding: 12px
        }
    }
</style>

