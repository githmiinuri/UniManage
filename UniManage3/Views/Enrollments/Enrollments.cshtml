                                <path d="M7 8h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" />
                            </svg>
                        </span>
                        <span class="small">Courses</span>
                    </a>
                    <a href='@Url.Action("Index", "Curriculum")' class="">
