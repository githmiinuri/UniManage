@model UniManage3.Models.CourseMaterialUploadViewModel

@{
    ViewData["Title"] = "Edit Course Material";
}

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-body p-4 p-lg-5">
                    <p class="text-uppercase small fw-semibold text-muted mb-2" style="letter-spacing: .08em;">Update resource</p>
                    <h1 class="h3 fw-bold text-dark mb-4">Edit course material</h1>

                    <form asp-action="Edit" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MaterialName" class="form-label fw-semibold"></label>
                            <input asp-for="MaterialName" class="form-control rounded-3" />
                            <span asp-validation-for="MaterialName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaterialType" class="form-label fw-semibold"></label>
                            <select asp-for="MaterialType" class="form-select rounded-3" asp-items="ViewBag.MaterialTypes"></select>
                            <span asp-validation-for="MaterialType" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Duration" class="form-label fw-semibold"></label>
                            <input asp-for="Duration" class="form-control rounded-3" />
                            <span asp-validation-for="Duration" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ModuleId" class="form-label fw-semibold"></label>
                            <select asp-for="ModuleId" class="form-select rounded-3" asp-items="ViewBag.ModuleId"></select>
                            <span asp-validation-for="ModuleId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-semibold">Current File</label>
                            @if (!string.IsNullOrEmpty(Model.FilePath))
                            {
                                <div class="mb-0">
                                    <a class="btn btn-outline-secondary btn-sm rounded-3 shadow-sm" asp-action="Download" asp-route-id="@Model.Id">Download current file</a>
                                    <span class="ms-2 small text-muted">@System.IO.Path.GetFileName(Model.FilePath)</span>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mb-0">No file uploaded yet.</div>
                            }
                        </div>

                        <div class="mb-4">
                            <label asp-for="UploadedFile" class="form-label fw-semibold">Replace File (optional)</label>
                            <input asp-for="UploadedFile" type="file" class="form-control rounded-3" />
                            <span asp-validation-for="UploadedFile" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <button type="submit" class="btn btn-primary rounded-3 shadow-sm px-4">Save changes</button>
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">Back to list</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
