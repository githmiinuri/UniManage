@model IEnumerable<UniManage3.Models.CourseMaterial>
@using UniManage3.Models

@{
    ViewData["Title"] = "Course Materials";
}

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <p class="text-uppercase small fw-semibold text-muted mb-2" style="letter-spacing: .08em;">Teaching resources</p>
                        <h1 class="h2 fw-bold text-dark mb-1">Course materials</h1>
                        <p class="text-muted mb-0 small">Manage PDFs, slides, recordings, and other files for your modules.</p>
                    </div>
                    <a asp-action="Create" class="btn btn-primary btn-lg rounded-3 shadow-sm text-nowrap">Upload new material</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Material name</th>
                                    <th>Type</th>
                                    <th class="d-none d-lg-table-cell" style="max-width: 14rem;">Description</th>
                                    <th>Duration</th>
                                    <th>Module</th>
                                    <th>File</th>
                                    <th class="pe-4 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.MaterialName</td>
                                        <td>
                                            @switch (item.MaterialType)
                                            {
                                                case MaterialTypeEnum.PDF:
                                                    <span class="badge rounded-pill text-bg-danger">@item.MaterialType</span>
                                                    break;
                                                case MaterialTypeEnum.PPT:
                                                    <span class="badge rounded-pill text-bg-warning">@item.MaterialType</span>
                                                    break;
                                                case MaterialTypeEnum.Video:
                                                    <span class="badge rounded-pill text-bg-primary">@item.MaterialType</span>
                                                    break;
                                                case MaterialTypeEnum.Audio:
                                                    <span class="badge rounded-pill text-bg-info">@item.MaterialType</span>
                                                    break;
                                                case MaterialTypeEnum.Image:
                                                    <span class="badge rounded-pill text-bg-success">@item.MaterialType</span>
                                                    break;
                                                default:
                                                    <span class="badge rounded-pill text-bg-secondary">@item.MaterialType</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell text-muted small text-truncate" style="max-width: 14rem;">@item.Description</td>
                                        <td class="text-nowrap">@item.Duration</td>
                                        <td>@item.Module?.ModuleName</td>
                                        <td class="small text-muted text-break">@(string.IsNullOrEmpty(item.FilePath) ? "-" : System.IO.Path.GetFileName(item.FilePath))</td>
                                        <td class="pe-4 text-end text-nowrap">
                                            <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Material actions">
                                                <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-outline-success" title="Download">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/></svg>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="align-text-bottom" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
