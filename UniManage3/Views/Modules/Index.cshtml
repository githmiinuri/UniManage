@model IEnumerable<UniManage3.Models.Module>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
@if (User.IsInRole("Administrator"))
{
    <a asp-action="Create">Create New</a>
}
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ModuleCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModuleName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lecturer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ModuleCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ModuleName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Course.CourseName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lecturer.FirstName )
            </td>
            <td>
                @if (User.IsInRole("Administrator"))
                {
                    <text>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a class="btn btn-sm btn-primary shadow-sm" href="@Url.Action("Index", "CourseMaterials", new { moduleId = item.Id })">Manage materials</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </text>
                }
                else
                {
                     <a class="btn btn-sm btn-primary shadow-sm" href="@Url.Action("Index", "CourseMaterials", new { moduleId = item.Id })">Manage materials</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
