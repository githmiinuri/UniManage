@model IEnumerable<UniManage3.Models.Module>

@{
    ViewData["Title"] = "My Assigned Modules";
}

<div class="container-fluid px-3 px-lg-4 py-4 bg-light min-vh-100">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-body p-4 p-lg-5">
                    <p class="text-uppercase small fw-semibold text-muted mb-2" style="letter-spacing: .08em;">UniManage · Modules</p>
                    <h1 class="h2 fw-bold text-dark mb-2">My assigned modules</h1>
                    <p class="text-muted mb-0 col-lg-8 px-0">Browse the modules linked to your teaching profile. Open a module for full details or jump straight to course materials.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-primary rounded-pill px-3 py-2">@Html.DisplayFor(modelItem => item.ModuleCode)</span>
                        </div>
                        <p class="small text-muted mb-0 text-uppercase fw-semibold" style="letter-spacing: .04em;">Course</p>
                        @if (item.Course != null)
                        {
                            <p class="fw-semibold text-dark mb-0 small">@Html.DisplayFor(modelItem => item.Course.CourseName)</p>
                        }
                    </div>
                    <div class="card-body px-4 pt-4 flex-grow-1 d-flex flex-column">
                        <h2 class="h5 fw-bold text-dark mb-3">@Html.DisplayFor(modelItem => item.ModuleName)</h2>
                        @if (item.Lecturer != null)
                        {
                            <p class="text-muted small mb-0 mt-auto">
                                <span class="text-uppercase fw-semibold" style="letter-spacing: .04em;">Lecturer</span><br />
                                @Html.DisplayFor(modelItem => item.Lecturer.FirstName)
                            </p>
                        }
                        else
                        {
                            <div class="mt-auto"></div>
                        }
                    </div>
                    <div class="card-footer bg-light border-0 px-4 py-3 d-flex flex-column flex-sm-row gap-2">
                        <a class="btn btn-outline-secondary rounded-3 flex-sm-fill" asp-action="Details" asp-route-id="@item.Id">View details</a>
                        <a class="btn btn-primary rounded-3 shadow-sm flex-sm-fill" href="@Url.Action("Index", "CourseMaterials", new { moduleId = item.Id })">Manage materials</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
