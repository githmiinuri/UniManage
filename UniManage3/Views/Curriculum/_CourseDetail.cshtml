@model UniManage3.Models.CourseCurriculumViewModel

<div class="curriculum-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Semesters</span>
        <button class="btn btn-sm btn-primary px-3" onclick="openSemesterModal(@Model.Course.Id)">
            <i class="fas fa-plus me-1"></i> Add Semester
        </button>
    </div>
    <div class="item-list p-3">
        @foreach (var sem in Model.Semesters)
        {
            <div class="semester-item p-3 mb-3 border rounded bg-white shadow-sm" style="min-height: 140px; transition: 0.3s;">
                <div class="d-flex justify-content-between align-items-start mb-3" onclick="selectSemester(@sem.Id, '@sem.SemesterName')" style="cursor:pointer">
                    <div>
                        <strong class="d-block h5 mb-1" style="color: var(--accent-blue)">@sem.SemesterName</strong>
                        <div class="text-muted">
                            <i class="fas fa-calendar-alt me-1"></i>
                            @sem.StartDate.ToString("MMM yyyy") - @sem.EndDate.ToString("MMM yyyy")
                        </div>
                        <div class="badge bg-light text-dark border mt-2">@sem.Modules.Count Modules</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                    <button class="btn btn-sm btn-outline-info flex-fill" onclick="openSemesterDetails(@sem.Id)">
                        <i class="fas fa-eye me-1"></i> Details
                    </button>
                    <button class="btn btn-sm btn-outline-secondary flex-fill" onclick="openSemesterEdit(@sem.Id)">
                        <i class="fas fa-edit me-1"></i> Edit
                    </button>
                    <button class="btn btn-sm btn-outline-danger flex-fill" onclick="deleteSemester(@sem.Id)">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="curriculum-card" style="grid-column: span 2;">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Module Management: <span id="selectedSemesterTitle" class="text-secondary">Select a semester</span></span>
        <button id="addModuleBtn" class="btn btn-sm btn-success px-3" style="display:none">
            <i class="fas fa-plus me-1"></i> Add Module
        </button>
    </div>
    <div id="moduleManagementPane" class="p-3">
        <p class="text-center mt-5 text-muted">Select a semester from the left to manage its modules.</p>
    </div>
</div>