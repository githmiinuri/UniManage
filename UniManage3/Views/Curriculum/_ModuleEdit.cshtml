@model UniManage3.Models.Module

<div class="module-form px-2">
    <form id="editModuleForm" method="post" action="@Url.Action("EditModule", "Curriculum")">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="SemesterId" value="@Model.SemesterId" />
        <input type="hidden" name="CourseId" value="@Model.CourseId" />

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label fw-bold">Module Code</label>
                <input name="ModuleCode" class="form-control" value="@Model.ModuleCode" required />
            </div>
            <div class="col-md-8 mb-3">
                <label class="form-label fw-bold">Module Name</label>
                <input name="ModuleName" class="form-control" value="@Model.ModuleName" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label fw-bold">Credits</label>
                <input type="number" name="Credits" class="form-control" value="@Model.Credits" required />
            </div>
            <div class="col-md-8 mb-3">
                <label class="form-label fw-bold">Assigned Lecturer</label>
                <select name="LecturerId" class="form-select" required>
                    <option value="">-- Select Lecturer --</option>
                    @if (ViewBag.Lecturers != null)
                    {
                        foreach (var item in (SelectList)ViewBag.Lecturers)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.LecturerId?.ToString() ? "selected" : null)">
                                @item.Text
                            </option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Description</label>
            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
        </div>

        <div class="d-flex gap-2 justify-content-end mt-4">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
        </div>
    </form>
</div>

<script>
    document.getElementById('editModuleForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);

        fetch(this.action, {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const modalInstance = bootstrap.Modal.getInstance(document.getElementById('dynamicModal'));
                if(modalInstance) modalInstance.hide();

                // Triggers both the Course cards and the Module Table refresh
                refreshCurriculumUI();
            } else {
                alert("Error: " + data.errors);
            }
        });
    });
</script>
