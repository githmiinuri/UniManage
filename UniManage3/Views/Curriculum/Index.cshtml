        <nav class="menu">
            <div class="menu-inner" id="menuInner">
                <div class="section">
                    <a href="/Admin/Index"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 13h8V3H3v10zM13 21h8v-6h-8v6zM13 3v6h8V3h-8zM3 21h8v-8H3v8z" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Dashboard</span></a>
                    <div class="has-submenu" tabindex="0" role="button">
                        <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls="userMgmtSub" onclick="toggleSub(this)">
                            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M16 11c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM8 11c1.657 0 3-1.343 3-3S9.657 5 8 5 5 6.343 5 8s1.343 3 3 3zM8 13c-2.667 0-8 1.333-8 4v2h16v-2c0-2.667-5.333-4-8-4z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                            <span class="small">User Management</span>
                            <span class="chev" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#eaf4ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </span>
                        </button>

                        <div id="userMgmtSub" class="submenu" role="region" aria-hidden="true">
                            <a href="/Admin/StudentManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="14" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 8h8" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg>
                                </span>
                                <span class="small">Student Management</span>
                            </a>
                            <a href="/Admin/LecturerManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v6" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /><path d="M6 8c0 3 3 5 6 5s6-2 6-5" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M4 20v-1c0-2 4-3 8-3s8 1 8 3v1" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </span>
                                <span class="small">Lecturer Management</span>
                            </a>
                            <a href="/Admin/AdministratorManagement" class="sub-action">
                                <span class="icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l6 3v5c0 5-6 9-6 9s-6-4-6-9V5l6-3z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                </span>
                                <span class="small">Administrator Management</span>
                            </a>
                        </div>
                    </div>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="7" r="4" stroke="#9fc8ff" stroke-width="1.2" /></svg></span><span class="small">Students</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z" stroke="#9fc8ff" stroke-width="1.2" /><path d="M4 20v-1c0-2.21 3.58-4 8-4s8 1.79 8 4v1" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Lecturers</span></a>
                    <a href="/Admin/Departments"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="16" height="16" rx="1" stroke="#9fc8ff" stroke-width="1.2" fill="none" /><path d="M8 20v-8h8v8" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /><path d="M10 8v2M14 8v2" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span><span class="small">Departments</span></a>
                    <a href='@Url.Action("Index", "Courses")' class="active">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="4" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" />
                                <path d="M7 8h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" />
                            </svg>
                        </span>
                        <span class="small">Courses</span>
                    </a>
                    <a href='@Url.Action("Index", "Curriculum")' class="">
                        <span class="icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="3" width="18" height="18" rx="2" stroke="#9fc8ff" stroke-width="1.2" />

                                <path d="M7 8h10M7 12h10M7 16h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" />
                            </svg>
                        </span>
                        <span class="small">Curriculum</span>
                    </a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 6h18" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" /><path d="M12 6v14" stroke="#9fc8ff" stroke-width="1.4" stroke-linecap="round" /></svg></span><span class="small">Classes</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="14" rx="2" stroke="#9fc8ff" stroke-width="1.2" /><path d="M7 21h10" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" /></svg></span><span class="small">Events</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3h18v18H3z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Library</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 3v18h18" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Enrollment</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="#9fc8ff" stroke-width="1.0" /><path d="M7 7h10v10H7z" stroke="#9fc8ff" stroke-width="1.0" /></svg></span><span class="small">Reports</span></a>
                    <a href="#"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2l9 21H3L12 2z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class="small">Performance</span></a>
                    <a href="/Account/EditProfile"><span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /><path d="M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" stroke="#9fc8ff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg></span><span class="small">Edit Profile</span></a>
                </div>

            </div>
        </nav>

        <div style="position:absolute;left:12px;right:12px;bottom:18px">
            <div style="display:flex;flex-direction:column;gap:8px">
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn" style="width:100%; height:40px; background:#ff4d4f; color:white; border-radius:8px; padding:0; border:none; display:flex; justify-content:center; align-items:center; text-align:center; cursor:pointer;">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </aside>


    <main class="content-wrap">
        <div class="page-header">
            <div>
                <div class="page-title">Curriculum Management</div>
                <div class="text-muted">@DateTime.UtcNow.ToString("MMMM d, dddd")</div>
            </div>
        </div>

        <div class="counter-row">
            <div class="counter card">
                <div class="small text-muted">Active Courses</div>
                <div style="font-weight:700; font-size:1.6rem; color:var(--accent-blue)">@ViewBag.TotalActiveCourses</div>
            </div>
          
        </div>

        <div class="card p-3 mb-4" style="border-radius:12px; box-shadow:var(--card-shadow); border: 1px solid #e2e8f0;">
            <div style="display:flex; align-items:center; gap:15px;">
                <i class="fas fa-book-open" style="color:var(--accent-blue)"></i>
                <label class="fw-bold">Select Degree Program:</label>
                <select class="form-select searchable-select" id="coursePicker" style="max-width:500px" onchange="loadCourseCurriculum(this.value)">
                    <option value="">-- Search and Select a Degree Program --</option>
                    @foreach (var course in Model)
                    {
                        <option value="@course.Id">@course.CourseCode - @course.CourseName</option>
                    }
                </select>
            </div>
        </div>

        <div id="curriculumDetails" class="management-grid" style="display:none">
        </div>
    </main>

    <div class="modal fade" id="semesterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:var(--accent-blue); color:white">
                    <h5 class="modal-title">Add New Semester</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="semesterForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body px-4">
                        <input type="hidden" name="CourseId" id="modalCourseId" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Semester Name</label>
                            <input type="text" name="SemesterName" class="form-control" placeholder="e.g., Year 1 Semester 1" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Start Date</label>
                                <input type="date" name="StartDate" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">End Date</label>
                                <input type="date" name="EndDate" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Save Semester</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="moduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:var(--accent-blue); color:white">
                    <h5 class="modal-title">Create New Module</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="moduleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SemesterId" id="modalSemId" />
                    <input type="hidden" name="CourseId" id="modalCourseIdForMod" />
                    <div class="modal-body px-4">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Module Code</label>
                                <input type="text" name="ModuleCode" class="form-control" placeholder="e.g., CS101" required />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Module Name</label>
                                <input type="text" name="ModuleName" class="form-control" placeholder="e.g., Introduction to Programming" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Credits</label>
                                <input type="number" name="Credits" class="form-control" value="0" required />
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Lecturer</label>
                                <select name="LecturerId" class="form-select" id="lecturerSelect" required>
                                    <option value="">-- Select Lecturer --</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Enter module objectives..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Create Module</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="dynamicModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:var(--accent-blue); color:white">
                    <h5 class="modal-title" id="dynamicModalTitle">Item Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="dynamicModalBody">
                </div>
            </div>
        </div>
    </div>

<script>
    function loadCourseCurriculum(courseId) {
        const container = document.getElementById('curriculumDetails');
        if(!courseId) {
            container.style.display = 'none';
            return;
        }

        container.style.display = 'grid';
        container.innerHTML = '<div style="grid-column: span 3; text-align:center; padding:50px;"><p>Loading...</p></div>';

        fetch(`/Curriculum/ManageCourse?courseId=${courseId}`)
            .then(res => {
                if(!res.ok) throw new Error("Course detail not found");
                return res.text();
            })
            .then(html => {
                container.innerHTML = html;
                initDragAndDrop();
            })
            .catch(err => {
                container.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
            });
    }

    function initDragAndDrop() {
        // Implementation for dragging modules from 'Unassigned' to 'Semesters'
        console.log("Drag and Drop Initialized");
    }
    function openSemesterModal(courseId) {
        document.getElementById('modalCourseId').value = courseId;
        const myModal = new bootstrap.Modal(document.getElementById('semesterModal'));
        myModal.show();
    }

    
    document.getElementById('semesterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(this);

        fetch('/Curriculum/CreateSemester', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                // Hide modal
                bootstrap.Modal.getInstance(document.getElementById('semesterModal')).hide();
                // Refresh the curriculum view
                loadCourseCurriculum(document.getElementById('modalCourseId').value);
                // Clear form
                this.reset();
            } else {
                alert("Error saving semester: " + data.errors);
            }
        });
    });
    // Load modules into the center pane when a semester is clicked
    function selectSemester(semesterId, semesterName) {
        const pane = document.getElementById('moduleManagementPane');
        pane.innerHTML = '<div class="text-center mt-5"><div class="spinner-border"></div></div>';

        // Update header of the center pane
        document.getElementById('selectedSemesterTitle').innerText = semesterName;
        document.getElementById('addModuleBtn').style.display = 'inline-block';
        document.getElementById('addModuleBtn').setAttribute('onclick', `openModuleModal(${semesterId})`);

        fetch(`/Curriculum/GetSemesterModules?semesterId=${semesterId}`)
            .then(res => res.text())
            .then(html => { pane.innerHTML = html; });
    }

        function openModuleModal(semId) {
        // 1. Get the Course ID currently selected in the main dropdown
        const courseId = document.getElementById('coursePicker').value;

        if(!courseId) {
            alert("Please select a course first.");
            return;
        }

        // 2. Populate the hidden fields in the modal
        document.getElementById('modalSemId').value = semId;
        document.getElementById('modalCourseIdForMod').value = courseId;

        // 3. Populate Lecturers dynamically
        fetch('/Curriculum/GetActiveLecturers')
            .then(res => res.json())
            .then(data => {
                const select = document.getElementById('lecturerSelect');
                select.innerHTML = '<option value="">-- Select Lecturer --</option>';
                data.forEach(l => {
                    select.innerHTML += `<option value="${l.id}">${l.name}</option>`;
                });

                // 4. Show the modal
                const myModal = new bootstrap.Modal(document.getElementById('moduleModal'));
                myModal.show();
            });
    }

    // Fixed Submission Logic
    document.getElementById('moduleForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(this);

        fetch('/Curriculum/CreateModule', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                bootstrap.Modal.getInstance(document.getElementById('moduleModal')).hide();
                // Refresh the curriculum view to show the new module
                loadCourseCurriculum(document.getElementById('modalCourseIdForMod').value);
                this.reset();
            } else {
                alert("Error: " + data.errors);
            }
        })
        .catch(err => console.error("Fetch Error:", err));
    });
        // Add these to your existing <script> block
    function updateModuleStatus(id, active) {
        // Get the current semester ID to refresh the pane later
        const semesterId = document.getElementById('modalSemId').value;

        fetch(`/Curriculum/ToggleModuleStatus?id=${id}&active=${active}`, {
            method: 'POST',
            headers: {
                // Include AntiForgeryToken if your controller requires it
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                // Refresh only the module pane
                const semesterName = document.getElementById('selectedSemesterTitle').innerText;
                selectSemester(semesterId, semesterName);
            } else {
                alert("Failed to update status.");
            }
        });
    }

    function deleteModule(id) {
        if(!confirm("Are you sure you want to permanently delete this module?")) return;

        const semesterId = document.getElementById('modalSemId').value;

        fetch(`/Curriculum/DeleteModule?id=${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                const semesterName = document.getElementById('selectedSemesterTitle').innerText;
                selectSemester(semesterId, semesterName);
            }
        });
    }

        // AUTO-REFRESH LOGIC
              function refreshCurriculumUI() {
            const courseId = document.getElementById('coursePicker').value;
            // We get the semId from the hidden input if it exists, otherwise from the active selection
            const semId = document.getElementById('modalSemId')?.value;
            const semTitle = document.getElementById('selectedSemesterTitle')?.innerText;

            // 1. Refresh the left pane (Semesters)
            loadCourseCurriculum(courseId);

            // 2. Refresh the module table if a semester was open
            if (semId && semId !== "") {
                // Short delay to allow the left pane DOM to settle
                setTimeout(() => {
                    selectSemester(semId, semTitle);
                }, 300);
            }
        }

        // SEMESTER ACTIONS
        function deleteSemester(id) {
            if (!confirm("Are you sure? This will permanently delete the semester and unassign its modules.")) return;
            fetch(`/Curriculum/DeleteSemester/${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => { if(data.success) refreshCurriculumUI(); });
        }

        function openSemesterEdit(id) {
            fetch(`/Curriculum/GetSemesterEdit/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('dynamicModalTitle').innerText = "Edit Semester";
                    document.getElementById('dynamicModalBody').innerHTML = html;

                    // Show modal
                    const modalEl = document.getElementById('dynamicModal');
                    new bootstrap.Modal(modalEl).show();

                    // Attach submit handler to the loaded form to prevent full-page navigation
                    const form = document.getElementById('editSemesterForm');
                    if (form) {
                        // Ensure we don't attach multiple listeners on repeated loads
                        if (!form.dataset.ajaxAttached) {
                            form.dataset.ajaxAttached = '1';
                            form.addEventListener('submit', function (e) {
                                e.preventDefault();
                                const formData = new FormData(this);
                                const tokenInput = this.querySelector('input[name="__RequestVerificationToken"]');

                                fetch(this.action, {
                                    method: 'POST',
                                    body: formData,
                                    headers: tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {}
                                })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        const inst = bootstrap.Modal.getInstance(modalEl);
                                        if (inst) inst.hide();
                                        refreshCurriculumUI();
                                    } else {
                                        alert("Error: " + (data.errors || "Failed to update semester."));
                                    }
                                })
                                .catch(err => console.error('Error:', err));
                            });
                        }
                    }
                });
        }

        // MODULE ACTIONS
        function openModuleEdit(id) {
            fetch(`/Curriculum/GetModuleEdit/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('dynamicModalTitle').innerText = "Edit Module";
                    document.getElementById('dynamicModalBody').innerHTML = html;

                    // Show modal
                    const modalEl = document.getElementById('dynamicModal');
                    new bootstrap.Modal(modalEl).show();

                    // Attach AJAX submit handler to the edit form
                    const form = document.getElementById('editModuleForm');
                    if (form) {
                        if (!form.dataset.ajaxAttached) {
                            form.dataset.ajaxAttached = '1';
                            form.addEventListener('submit', function (e) {
                                e.preventDefault();
                                const formData = new FormData(this);
                                const tokenInput = this.querySelector('input[name="__RequestVerificationToken"]');

                                fetch(this.action, {
                                    method: 'POST',
                                    body: formData,
                                    headers: tokenInput ? { 'RequestVerificationToken': tokenInput.value } : {}
                                })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        const inst = bootstrap.Modal.getInstance(modalEl);
                                        if (inst) inst.hide();
                                        refreshCurriculumUI();
                                    } else {
                                        alert('Error: ' + (data.errors || 'Failed to update module.'));
                                    }
                                })
                                .catch(err => console.error('Error:', err));
                            });
                        }
                    }
                });
        }
                function openSemesterDetails(id) {
            fetch(`/Curriculum/GetSemesterDetails/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('dynamicModalTitle').innerText = "Semester Details";
                    document.getElementById('dynamicModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('dynamicModal')).show();
                });
        }

        function openModuleDetails(id) {
            fetch(`/Curriculum/GetModuleDetails/${id}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('dynamicModalTitle').innerText = "Module Details";
                    document.getElementById('dynamicModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('dynamicModal')).show();
                });
        }

        // Module list filtering (moved here so it works after partials are injected)
        function filterModules() {
            const inputEl = document.getElementById('moduleSearchInput');
            if (!inputEl) return;
            const input = inputEl.value.toLowerCase();
            const rows = document.querySelectorAll('.module-row');

            rows.forEach(row => {
                const nameCell = row.querySelector('.module-name-cell');
                const name = nameCell ? nameCell.innerText.toLowerCase() : '';
                if (name.includes(input)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function resetModuleSearch() {
            const inputEl = document.getElementById('moduleSearchInput');
            if (inputEl) inputEl.value = '';
            const rows = document.querySelectorAll('.module-row');
            rows.forEach(row => { row.style.display = ''; });
        }
</script>
