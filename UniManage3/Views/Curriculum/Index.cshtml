@model IEnumerable<UniManage3.Models.Course>
@using Microsoft.AspNetCore.Mvc.Rendering
@inject UniManage3.Data.ApplicationDbContext _db
@{
    Layout = "_Layout";
    ViewData["Title"] = "Curriculum Management";
    var email = User?.Identity?.Name;
    var fullName = _db.Users.FirstOrDefault(u => u.Email == email)?.FullName ?? email ?? "Administrator";
}

<style>
    :root {
        /* Core Branding & Sidebar Variables from Student Management */
        --gradient: linear-gradient(135deg, #0b4f8a 0%, #6d28d9 100%);
        --sidebar-width: 260px;
        --sidebar-collapsed: 64px;
        --accent-blue: #0b4f8a;
        --light-blue: #9fc8ff;
        --muted: #6c757d;
        --card-shadow: 0 8px 20px rgba(12,42,80,0.06);
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
    }

    body {
        font-family: var(--font-stack);
        background: #f8fafc;
        color: #0b2b4a;
        margin: 0;
    }

    .admin-shell {
        display: flex;
        min-height: 100vh
    }
    /* ensure submenu stacking and positioning */
    .has-submenu {
        position: relative
    }

        .has-submenu .submenu {
            position: relative;
            z-index: 5;
            pointer-events: auto
        }

        .has-submenu .submenu-toggle {
            z-index: 6
        }

    /* --- SIDEBAR STRUCTURE (Merged from Student Management) --- */
    .left-bar {
        width: var(--sidebar-width);
        background: var(--gradient);
        color: #eaf4ff;
        padding: 18px 12px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        transition: width .25s ease-in-out
    }

        .left-bar.collapsed {
            width: var(--sidebar-collapsed)
        }

        .left-bar .logo-top {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px
        }

    .logo-mark {
        display: flex;
        align-items: center;
        gap: 10px
    }

        .logo-mark svg {
            background: transparent
        }

    .brand-name {
        font-weight: 700;
        color: #eafbff
    }

    .logo-username {
        font-size: .9rem;
        color: rgba(255,255,255,0.9);
        margin-top: 12px
    }

    .menu {
        margin-top: 20px
    }

        .menu .section {
            margin-bottom: 12px
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px;
            border-radius: 8px;
            color: rgba(255,255,255,0.92);
            text-decoration: none;
            margin-bottom: 6px
        }

            .menu a .icon {
                width: 26px;
                height: 26px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 6px
            }

            .menu a:hover {
                background: rgba(255,255,255,0.06);
                color: #eaf4ff
            }

            .menu a.active {
                background: rgba(255,255,255,0.12);
                box-shadow: var(--card-shadow)
            }

        .menu .small {
            font-size: .85rem;
            color: rgba(255,255,255,0.85)
        }

        .menu .sep {
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin: 12px 0;
            border-radius: 2px
        }

    .bottom-actions {
        position: absolute;
        bottom: 18px;
        left: 12px;
        right: 12px;
        padding-right: 8px
    }

        .bottom-actions a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border-radius: 8px;
            color: rgba(255,255,255,0.9);
            text-decoration: none
        }
    /* submenu styles */
    .has-submenu .submenu-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: space-between;
        width: 100%;
    }

    .has-submenu .chev {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transform: rotate(0);
        transition: transform .18s ease
    }

    .has-submenu .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .22s ease,opacity .18s ease;
        padding-left: 36px;
        opacity: 0
    }

        .has-submenu .submenu a.sub-action {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 8px;
            border-radius: 6px;
            color: rgba(255,255,255,0.9);
            text-decoration: none;
            margin: 4px 0
        }

            .has-submenu .submenu a.sub-action .icon {
                width: 18px;
                height: 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                flex: 0 0 18px
            }

    .has-submenu.open .chev {
        transform: rotate(90deg)
    }

    .has-submenu.open .submenu {
        opacity: 1;
        max-height: 400px
    }
    /* style the submenu-toggle when it's a button so it matches links */
    .has-submenu .submenu-toggle {
        background: transparent;
        border: none;
        padding: 8px 10px;
        cursor: pointer;
        color: inherit;
        font: inherit;
        text-align: left;
        width: 100%;
        display: flex;
        align-items: center
    }

        .has-submenu .submenu-toggle.active {
            background: rgba(255,255,255,0.12);
            box-shadow: var(--card-shadow)
        }
    /* hide native scrollbar but allow programmatic scrolling */
    .menu-inner {
        max-height: calc(100vh - 240px);
        overflow: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .menu-inner::-webkit-scrollbar {
            display: none;
        }

    /* --- CONTENT AREA & DEPARTMENT SPECIFIC STYLES --- */
    .content-wrap {
        margin-left: var(--sidebar-width);
        flex: 1;
        padding: 28px;
        transition: margin-left .25s ease-in-out
    }

    .left-bar.collapsed + .content-wrap {
        margin-left: var(--sidebar-collapsed)
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--accent-blue);
    }

    .page-actions {
        display: flex;
        align-items: center;
        gap: 12px
    }

    .card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        box-shadow: var(--card-shadow);
    }

    .counter-row {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
    }

    .counter {
        flex: 0 0 180px;
        background: #fff;
        border-radius: 10px;
        padding: 12px;
        box-shadow: var(--card-shadow);
        border: 1px solid #eef3fb;
    }
    .search-bar {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 12px 10px;
            border-bottom: 1px solid #eef3fb;
            text-align: left;
        }

    /* Buttons & Modals */
    .btn {
        background: var(--accent-blue);
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-secondary {
        background: transparent;
        border: 1px solid #e6eefc;
        padding: 8px 16px;
        border-radius: 8px;
        color: var(--accent-blue);
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .modal {
        background: white;
        border-radius: 12px;
        padding: 24px;
        max-width: 600px;
        width: 95%;
        box-shadow: var(--card-shadow);
    }

    .searchable-select {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #e6eefc;
    }

    .management-grid {
        display: grid;
        grid-template-columns: 350px 1fr; /* Two column focus as requested */
        gap: 20px;
        margin-top: 24px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .left-bar {
            position: relative;
            width: 100%;
            height: auto;
        }

        .content-wrap {
            margin-left: 0;
            padding: 12px;
        }
    }
</style>

</style>

<div class="admin-shell">
    <aside class="left-bar" id="leftBar">
        <div class="logo-top">
            <div class="logo-mark">
                <div style="width:56px;height:56px;border-radius:12px;background:white;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(11,79,138,0.12);">
                    <!-- exact login logo SVG -->
                    <svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="64" height="64" rx="12" fill="white" />
                        <path d="M32 4 L12 14 L32 24 L52 14 L32 4 Z" fill="#0b4f8a" />
                        <path d="M20 30 C24 34, 28 36, 32 36 C36 36,40 34,44 30 V46 C44 50,40 54,32 54 C24 54,20 50,20 46 V30 Z" fill="#6ea8fe" opacity="0.95" />
