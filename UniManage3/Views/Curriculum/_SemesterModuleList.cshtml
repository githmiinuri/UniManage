@model IEnumerable<UniManage3.Models.Module>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <div class="search-bar">
        <div style="display:flex;gap:8px;align-items:center">
            <input id="moduleSearchInput" class="form-control" placeholder="Search by Module Name" style="min-width:360px;" />
            <button class="btn btn-primary" type="button" onclick="filterModules()">Search</button>
            <button type="button" class="btn btn-outline-secondary" onclick="resetModuleSearch()">Refresh</button>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table align-middle" id="moduleTable">
        <thead>
            <tr class="text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                <th style="width: 10%">Code</th>
                <th style="width: 25%">Module Name</th>
                <th style="width: 20%">Lecturer</th>
                <th style="width: 15%">Status</th>
                <th style="width: 30%" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mod in Model)
            {
                
                <tr class="module-row" style="@(mod.IsActive ? "" : "opacity: 0.8; background-color: #fffafa;")">
                    <td class="fw-bold" style="color: var(--accent-blue);">@mod.ModuleCode</td>

                   
                    <td class="module-name-cell">@mod.ModuleName</td>

                    <td>
                        <span class="small">
                            <i class="fas fa-user-tie me-1 text-muted"></i>
                            @(mod.Lecturer != null ? $"{mod.Lecturer.FirstName} {mod.Lecturer.LastName}" : "Unassigned")
                        </span>
                    </td>
                    <td>
                        <span class="badge @(mod.IsActive ? "bg-success" : "bg-danger")" style="padding: 6px 12px; border-radius: 6px;">
                            @(mod.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-outline-info" onclick="openModuleDetails(@mod.Id)">
                                <i class="fas fa-info-circle me-1"></i> Details
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="openModuleEdit(@mod.Id)">
                                <i class="fas fa-edit me-1"></i> Edit
                            </button>

                            @if (mod.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-warning" onclick="updateModuleStatus(@mod.Id, false)">
                                    <i class="fas fa-pause me-1"></i> Hold
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" onclick="updateModuleStatus(@mod.Id, true)">
                                    <i class="fas fa-play me-1"></i> Restore
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteModule(@mod.Id)">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Filters the table rows based on the input text
    function filterModules() {
        const input = document.getElementById('moduleSearchInput').value.toLowerCase();
        const rows = document.querySelectorAll('.module-row');

        rows.forEach(row => {
            const name = row.querySelector('.module-name-cell').innerText.toLowerCase();
            if (name.includes(input)) {
                row.style.display = ''; // Show row
            } else {
                row.style.display = 'none'; // Hide row
            }
        });
    }

    // Resets the table to show all modules
    function resetModuleSearch() {
        document.getElementById('moduleSearchInput').value = '';
        const rows = document.querySelectorAll('.module-row');
        rows.forEach(row => {
            row.style.display = ''; // Show all
        });
    }
</script>